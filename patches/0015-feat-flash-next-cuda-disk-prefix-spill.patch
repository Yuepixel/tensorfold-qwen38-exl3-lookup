From 6bcb40806695602418f5659f59e00f019e96439d Mon Sep 17 00:00:00 2001
From: Yuepixel <yuepixel@users.noreply.github.com>
Date: Sat, 10 Oct 2026 19:41:04 +0800
Subject: [PATCH 3/3] serve: keep prefix spill on by default (TF_SPILL_GIB=8,
 TF_SPILL_MIN_TOKENS=2048)

---
 run_serve.sh | 12 +++++++-----
 1 file changed, 7 insertions(+), 5 deletions(-)

diff --git a/run_serve.sh b/run_serve.sh
index ef8ff73..b2d495d 100644
--- a/run_serve.sh
+++ b/run_serve.sh
@@ -5,12 +5,11 @@ set -e
 # elsewhere, byte-exact vs serial either way. Set TF_EXL3_LOOKUP="" to revert to MTP-only (A6), or to
 # another lN[:M] / "auto" (auto is experimental; its gate cost model is not yet calibrated).
 export TF_EXL3_LOOKUP="${TF_EXL3_LOOKUP-l7:2}"
-# P14 native vision: the Lygodactylus 4bpw package stores the visual tower unquantized (16-bit) INLINE
-# in the model snapshot (model.visual.* in the index -> shard9), so no external FP16 sidecar is needed.
-# Leaving TENSORFOLD_VISION_WEIGHTS empty makes qwen_cuda.py read the tower from the model dir.
-# To fall back to the old external FP16 sidecar, export TENSORFOLD_VISION_WEIGHTS=/models/vision-f16-Qwen3.8-Flash-Next-exl3-3.05bpw.safetensors
+# P19 (2026-10-10) native vision: the turboderp 3.05bpw package stores the visual tower quantized
+# INLINE (model.visual.* in the index), so the CUDA vision path needs the external FP16 sidecar set
+# below. Point TENSORFOLD_VISION_WEIGHTS at the sidecar and qwen_cuda.py loads the tower from it.
 # Set TF_EXL3_VISION=0 to serve text-only (one-line revert).
-export TENSORFOLD_VISION_WEIGHTS="${TENSORFOLD_VISION_WEIGHTS-}"
+export TENSORFOLD_VISION_WEIGHTS="${TENSORFOLD_VISION_WEIGHTS-/models/vision-f16-Qwen3.8-Flash-Next-exl3-3.05bpw.safetensors}"
 # P13 (2026-10-08) multi-image knobs, raised for 12 full-quality images:
 #  - max-images: the request gate (it counts images across the FULL history at parse time; pure
 #    check, no memory cost). 4 -> 12 so a 12-image request is accepted without dilution.
@@ -50,4 +49,7 @@ VISION_ARG=""
 if [ "${TF_EXL3_VISION:-1}" != "0" ]; then
   VISION_ARG="--vision --vision-max-images ${TENSORFOLD_VISION_MAX_IMAGES} --vision-image-tokens ${TENSORFOLD_VISION_IMAGE_TOKENS}"
 fi
+export TF_SPILL_GIB=${TF_SPILL_GIB-8}
+export TF_SPILL_DIR=${TF_SPILL_DIR-/models/prefix-spill}
+export TF_SPILL_MIN_TOKENS=${TF_SPILL_MIN_TOKENS-2048}
 exec /usr/local/bin/tensorfold serve /models/Qwen3.8-Flash-Next-exl3-3.05bpw_h5_ng5 --host 127.0.0.1 --port 8080 --parallel 2 --max-tokens ${TENSORFOLD_MAX_TOKENS} $MTP_ARG $CONF_ARG $VISION_ARG > /tmp/serve.log 2>&1
