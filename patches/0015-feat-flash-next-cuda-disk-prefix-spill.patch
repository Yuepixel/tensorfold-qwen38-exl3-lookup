--- /dev/null
+++ b/tests/cuda/test_flashnext_spill.py
@@ -0,0 +1,77 @@
+"""Disk spill on the GPU (P21a): a kept prompt end written to disk and restored into a fresh slot resumes at the
+kept point, and its reply is token-for-token a fresh prefill's (bf16 and int8 caches)."""
+
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from test_flashnext_forward import V, _model  # noqa: E402
+
+from tensorfold.cuda.markers import snapshot_points  # noqa: E402
+from tensorfold.cuda.streams import Stream  # noqa: E402
+from tensorfold.engine.exact_sampling import Sampling  # noqa: E402
+from tensorfold.families.qwen4_exp.cuda.decode import Engine, prefill, serial_decode  # noqa: E402
+from tensorfold.families.qwen4_exp.cuda.multi import MultiDecoder, _slot  # noqa: E402
+from tensorfold.families.qwen4_exp.cuda.spill import SpillStore  # noqa: E402
+from tensorfold.families.qwen4_exp.cuda.state import State  # noqa: E402
+
+OPEN, ASSISTANT = V - 2, V - 1
+SAMPLING = Sampling(seed=31, top_k=20, top_p=0.95)
+
+
+@pytest.fixture(scope="module")
+def w():
+    return _model()
+
+
+def _fresh(w, prompt, count, kv_dtype):
+    e = Engine(w, capacity=1024, max_rows=8, prefill_rows=16, kv_dtype=kv_dtype)
+    return serial_decode(e, prefill(e, prompt, SAMPLING), count, SAMPLING, stop_eos=False).tokens
+
+
+def _run(dec, prompt, count):
+    s = Stream(list(prompt), count, SAMPLING, stop_eos=False)
+    dec.admit(s)
+    while dec.live():
+        dec.finish(dec.round())
+    return s
+
+
+@pytest.mark.parametrize("kv_dtype", ["bf16", "int8"])
+def test_a_spilled_prefix_resumes_token_for_token(w, kv_dtype, tmp_path):
+    g = torch.Generator().manual_seed(7)
+    block = torch.randint(1, V - 2, (320,), generator=g).tolist()
+    user = torch.randint(1, V - 2, (16,), generator=g).tolist()
+    prompt = [OPEN] + block + [OPEN] + user + [OPEN, ASSISTANT]
+    points = snapshot_points((OPEN,), (OPEN, ASSISTANT))
+
+    dec = MultiDecoder(w, slots=3, capacity=1024, depth=3, confidence=0.3, kv_dtype=kv_dtype, points=points)
+    _run(dec, prompt, 8)
+    entries = [k for k in dec.kept if len(k[0]) < len(prompt)]
+    assert entries, "the run kept no resumable prefix"
+    ids, st, snap, tail = max(entries, key=lambda k: len(k[0]))
+
+    store = SpillStore(tmp_path, min_tokens=1)
+    assert store.record(ids, st, snap, tail) is not None
+    assert store.bytes_on_disk() > 0
+
+    hit = store.lookup(prompt)
+    assert hit is not None and hit[0] == ids
+
+    dst = State(w, capacity=1024, max_rows=4, kv_dtype=kv_dtype)
+    snap2, tail2 = store.restore(ids, dst)
+    assert snap2["pos"] == snap["pos"]
+    assert torch.equal(snap2["rec"].to(snap["rec"].device), snap["rec"])
+    assert torch.equal(snap2["conv"].to(snap["conv"].device), snap["conv"])
+
+    e2 = _slot(w, dst, dec.buf, dec.mbuf, dec.pbuf, 1024, dec.prefill_rows)
+    first = prefill(e2, prompt, SAMPLING, resume={"state": snap2, "tail": tail2})
+    assert serial_decode(e2, first, 8, SAMPLING, stop_eos=False).tokens == _fresh(w, prompt, 8, kv_dtype)
+    assert e2.st.pos >= snap["pos"]
+
+
+def test_off_when_small_or_disabled(tmp_path):
+    store = SpillStore(tmp_path, min_tokens=100)
+    assert store.lookup([1, 2, 3]) is None
