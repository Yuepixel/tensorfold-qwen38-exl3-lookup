diff --git a/src/tensorfold/families/qwen4_exp/cuda/spill.py b/src/tensorfold/families/qwen4_exp/cuda/spill.py
new file mode 100644
index 0000000..e49b727
--- /dev/null
+++ b/src/tensorfold/families/qwen4_exp/cuda/spill.py
@@ -0,0 +1,226 @@
+"""Disk spill for Flash Next (CUDA) kept prompt ends: an evicted kept state writes its KV rows and its recurrent
+snapshot to a per-prompt file, so a later request that extends the same prefix resumes from disk instead of a cold
+prefill. The format is model-agnostic; the ``MultiDecoder`` calls it on eviction and on shutdown.
+
+A prompt's file is two objects: ``<name>.safetensors`` holds the tensors (the snapshot's small state and the cache
+rows below the kept point), ``<name>.json`` the metadata the resume reads before any tensor loads (the token ids, the
+kept length, the KV geometry). The engine off by default (``TF_SPILL_GIB`` unset or 0); ``TF_SPILL_MIN_TOKENS``
+(default 8192) skips prefixes cheap to recompute.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+
+DIR_ENV = "TF_SPILL_DIR"
+GIB_ENV = "TF_SPILL_GIB"
+MIN_TOKENS_ENV = "TF_SPILL_MIN_TOKENS"
+DEFAULT_DIR = Path("~/.cache/tensorfold/prefix-spill")
+DEFAULT_MIN_TOKENS = 8192
+GIB = 1024**3
+
+
+def fingerprint(model_dir) -> str:
+    """A short, stable name for a checkpoint, so two models' spilled prefixes never share a directory."""
+
+    path = Path(model_dir).resolve()
+    return f"{path.name}-{hashlib.sha256(str(path).encode()).hexdigest()[:12]}"
+
+
+def from_env(model_dir=None) -> "SpillStore | None":
+    """The store ``TF_SPILL_GIB`` asks for, or None when the engine is off (its default)."""
+
+    raw = os.environ.get(GIB_ENV, "").strip()
+    try:
+        gib = float(raw) if raw else 0.0
+    except ValueError:
+        raise ValueError(f"{GIB_ENV}: GiB (0: off), not {raw!r}") from None
+    if gib <= 0:
+        return None
+    root = os.environ.get(DIR_ENV, "").strip() or DEFAULT_DIR
+    root = Path(root).expanduser()
+    if model_dir is not None:
+        root = root / fingerprint(model_dir)
+    raw = os.environ.get(MIN_TOKENS_ENV, "").strip()
+    try:
+        min_tokens = int(raw) if raw else DEFAULT_MIN_TOKENS
+    except ValueError:
+        raise ValueError(f"{MIN_TOKENS_ENV}: rows, not {raw!r}") from None
+    if min_tokens < 0:
+        raise ValueError(f"{MIN_TOKENS_ENV}: 0 or more, not {min_tokens}")
+    return SpillStore(root, min_tokens=min_tokens, max_bytes=int(gib * GIB))
+
+
+class SpillStore:
+    """One directory of spilled kept prefixes; every write is atomic and the directory is trimmed to ``max_bytes``."""
+
+    def __init__(self, root, *, min_tokens: int = DEFAULT_MIN_TOKENS, max_bytes: int | None = None) -> None:
+        self.root = Path(root).expanduser()
+        self.min_tokens = int(min_tokens)
+        self.max_bytes = None if max_bytes is None else int(max_bytes)
+
+    # -- naming -----------------------------------------------------------------------------------------
+    def name(self, ids) -> str:
+        return hashlib.sha256(",".join(str(int(t)) for t in ids).encode()).hexdigest()[:32]
+
+    def _tensors(self, ids) -> Path:
+        return self.root / f"{self.name(ids)}.safetensors"
+
+    def _meta(self, ids) -> Path:
+        return self.root / f"{self.name(ids)}.json"
+
+    # -- writing ----------------------------------------------------------------------------------------
+    def record(self, ids, st, snap: dict, tail) -> Path | None:
+        """Write a kept prompt end (its cache rows and snapshot); None when it is below ``min_tokens``."""
+
+        ids = [int(t) for t in ids]
+        pos = int(snap["pos"])
+        if pos < self.min_tokens:
+            return None
+        from safetensors.torch import save_file
+
+        tensors, meta = self._collect(ids, st, snap, pos, tail)
+        self.root.mkdir(parents=True, exist_ok=True)
+        path, sidecar = self._tensors(ids), self._meta(ids)
+        tmp = path.with_name(f"{path.name}.tmp-{os.getpid()}-{time.time_ns()}")
+        try:
+            save_file(tensors, str(tmp), metadata={"format": "tensorfold-spill"})
+            os.replace(tmp, path)
+            meta_tmp = sidecar.with_name(f"{sidecar.name}.tmp-{os.getpid()}-{time.time_ns()}")
+            meta_tmp.write_text(json.dumps(meta))
+            os.replace(meta_tmp, sidecar)
+        finally:
+            tmp.unlink(missing_ok=True)
+        self.trim()
+        return path
+
+    def _collect(self, ids, st, snap: dict, pos: int, tail) -> tuple[dict, dict]:
+        """The CPU tensors and metadata of one kept point: the snapshot's state, the cache rows ``[0:pos]``, the
+        MTP head's ``[0:mtp_len]`` and its tail. Copied off the GPU here, before the caller may shrink the slot."""
+
+        def cpu(t):
+            return t.detach().to("cpu").contiguous()
+
+        mtp_len = int(snap["mtp_len"])
+        t: dict[str, torch.Tensor] = {
+            "rec": cpu(snap["rec"]), "conv": cpu(snap["conv"]), "ple_tail": cpu(snap["ple_tail"]),
+        }
+        if snap["ple_history"] is not None:
+            t["ple_history"] = torch.from_numpy(np.ascontiguousarray(snap["ple_history"]))
+        if tail is not None:
+            t["tail"] = cpu(tail)
+        for i, kc in enumerate(st.kc):
+            t[f"kc.{i}.k"] = cpu(kc.k[:pos])
+            t[f"kc.{i}.v"] = cpu(kc.v[:pos])
+            if kc.quantized:
+                t[f"kc.{i}.ks"] = cpu(kc.ks[:pos])
+                t[f"kc.{i}.vs"] = cpu(kc.vs[:pos])
+            t[f"ikc.{i}"] = cpu(st.ikc[i][:pos])
+            t[f"pooled.{i}"] = cpu(st.pooled[i][:pos // st.ratio])
+        meta = {"ids": ids, "pos": pos, "mtp_len": mtp_len, "kv_dtype": st.kv_dtype, "ratio": st.ratio,
+                "layers": len(st.kc), "quantized": bool(st.kc and st.kc[0].quantized), "mtp": hasattr(st, "mtp_kc"),
+                "ple": snap["ple_history"] is not None, "tail": tail is not None, "saved": time.time()}
+        if mtp_len and hasattr(st, "mtp_kc"):
+            t["mtp.k"] = cpu(st.mtp_kc.k[:mtp_len])
+            t["mtp.v"] = cpu(st.mtp_kc.v[:mtp_len])
+            if st.mtp_kc.quantized:
+                t["mtp.ks"] = cpu(st.mtp_kc.ks[:mtp_len])
+                t["mtp.vs"] = cpu(st.mtp_kc.vs[:mtp_len])
+            t["mtp.ikc"] = cpu(st.mtp_ikc[:mtp_len])
+            t["mtp.pooled"] = cpu(st.mtp_pooled[:mtp_len // st.ratio])
+        return t, meta
+
+    # -- reading ----------------------------------------------------------------------------------------
+    def lookup(self, prompt) -> tuple[list[int], dict] | None:
+        """The longest strict prefix of ``prompt`` on disk (its metadata), or None."""
+
+        if not self.root.is_dir():
+            return None
+        prompt = [int(t) for t in prompt]
+        best: tuple[list[int], dict] | None = None
+        for sidecar in self.root.glob("*.json"):
+            if not sidecar.with_suffix(".safetensors").is_file():
+                continue
+            try:
+                meta = json.loads(sidecar.read_text())
+            except (OSError, ValueError):
+                continue
+            ids = meta.get("ids")
+            n = len(ids) if isinstance(ids, list) else 0
+            if n and n < len(prompt) and prompt[:n] == ids and (best is None or n > len(best[0])):
+                best = (ids, meta)
+        return best
+
+    def restore(self, ids, dst) -> tuple[dict, object]:
+        """Load the spilled rows into the destination slot and rebuild the resume (snapshot, tail)."""
+
+        from safetensors.torch import load_file
+
+        ids = [int(t) for t in ids]
+        meta = json.loads(self._meta(ids).read_text())
+        pos, mtp_len = int(meta["pos"]), int(meta["mtp_len"])
+        if pos > dst.capacity:
+            raise ValueError(f"a {pos}-row spilled prefix does not fit a {dst.capacity}-row slot")
+        if meta.get("kv_dtype") != dst.kv_dtype or int(meta.get("ratio", dst.ratio)) != dst.ratio:
+            raise ValueError("a spilled prefix needs a slot with matching cache geometry")
+        t = load_file(str(self._tensors(ids)))
+
+        def into(mine, name):
+            mine.copy_(t[name].to(mine.device))
+
+        snap = {"pos": pos, "rec": t["rec"].to(dst.rec.device), "conv": t["conv"].to(dst.conv.device),
+                "ple_tail": t["ple_tail"].to(dst.ple_tail.device),
+                "ple_history": t["ple_history"].numpy() if "ple_history" in t else None, "mtp_len": mtp_len}
+        for i in range(int(meta["layers"])):
+            into(dst.kc[i].k[:pos], f"kc.{i}.k")
+            into(dst.kc[i].v[:pos], f"kc.{i}.v")
+            if dst.kc[i].quantized:
+                into(dst.kc[i].ks[:pos], f"kc.{i}.ks")
+                into(dst.kc[i].vs[:pos], f"kc.{i}.vs")
+            dst.ikc[i][:pos].copy_(t[f"ikc.{i}"].to(dst.ikc[i].device))
+            dst.pooled[i][:pos // dst.ratio].copy_(t[f"pooled.{i}"].to(dst.pooled[i].device))
+        if mtp_len and hasattr(dst, "mtp_kc"):
+            into(dst.mtp_kc.k[:mtp_len], "mtp.k")
+            into(dst.mtp_kc.v[:mtp_len], "mtp.v")
+            if dst.mtp_kc.quantized:
+                into(dst.mtp_kc.ks[:mtp_len], "mtp.ks")
+                into(dst.mtp_kc.vs[:mtp_len], "mtp.vs")
+            dst.mtp_ikc[:mtp_len].copy_(t["mtp.ikc"].to(dst.mtp_ikc.device))
+            dst.mtp_pooled[:mtp_len // dst.ratio].copy_(t["mtp.pooled"].to(dst.mtp_pooled.device))
+        tail = t["tail"].to(dst.conv.device) if meta.get("tail") else None
+        return snap, tail
+
+    # -- housekeeping -----------------------------------------------------------------------------------
+    def trim(self) -> None:
+        """Remove the oldest spilled prefixes until the directory holds ``max_bytes`` or less."""
+
+        if self.max_bytes is None or not self.root.is_dir():
+            return
+        files = sorted(self.root.glob("*.safetensors"), key=lambda p: p.stat().st_mtime)
+        total = sum(self.total_of(p) for p in files)
+        for path in files:
+            if total <= self.max_bytes:
+                break
+            total -= self.total_of(path)
+            self._remove(path)
+
+    def total_of(self, tensors_path: Path) -> int:
+        sidecar = tensors_path.with_suffix(".json")
+        return tensors_path.stat().st_size + (sidecar.stat().st_size if sidecar.is_file() else 0)
+
+    def _remove(self, tensors_path: Path) -> None:
+        for path in (tensors_path, tensors_path.with_suffix(".json")):
+            try:
+                path.unlink()
+            except OSError:
+                pass
+
+    def bytes_on_disk(self) -> int:
+        return sum(self.total_of(p) for p in self.root.glob("*.safetensors")) if self.root.is_dir() else 0
