 .../families/qwen4_exp/cuda/engine.py         |  5 +-
 tests/cuda/test_flashnext_sys_checkpoint.py   | 67 +++++++++++++++
 tests/test_cuda_sys_checkpoint.py             | 84 +++++++++++++++++++
 4 files changed, 190 insertions(+), 6 deletions(-)
