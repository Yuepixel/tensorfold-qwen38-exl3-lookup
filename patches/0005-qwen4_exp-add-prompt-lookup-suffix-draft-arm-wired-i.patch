@@ -500,3 +506,85 @@ def mtp_decode(e: Engine, pending: int, count: int, sampling: Sampling | None, *
         absorb(e, b.streams[:unabsorbed[0]], unabsorbed[1])
     committed = out[:st.pos - pos0]
