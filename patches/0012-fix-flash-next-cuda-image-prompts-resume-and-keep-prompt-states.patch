@@ -203,3 +203,144 @@ def test_image_message_markers_never_seed_a_text_prefix_cache():
     ref = Engine(w, capacity=1024, max_rows=8, prefill_rows=16)
     first = prefill(ref, prompt, None, mtp=False)
