+        if "pooled.0" not in t and self.repool is not None:
+            self.repool(dst, pos, mtp_len)     # a text prefix's pooled blocks, recomputed from the restored keys
         tail = t["tail"].to(dst.conv.device) if meta.get("tail") else None
