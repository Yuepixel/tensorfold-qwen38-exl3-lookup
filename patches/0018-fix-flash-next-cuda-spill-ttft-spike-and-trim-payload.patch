From 99afd200607a6a0c98365728547d78f55e642181 Mon Sep 17 00:00:00 2001
From: Yuepixel <yuepixel@users.noreply.github.com>
Date: Sat, 10 Oct 2026 18:32:00 +0000
Subject: [PATCH 1/2] fix(flash next cuda): stage spill copies through pooled
 pinned host buffers (P21c)

The eviction hot path copied cache rows with a pageable .to(cpu) that blocks as the prefix grows; stage through pinned buffers (non_blocking D2H + one synchronize) and pool them by size so an eviction reuses a buffer instead of re-paying the cold cudaHostAlloc. Cuts the per-eviction gap from 7-16 s to <=1 s on a monotonic growth load (rest still 0.05 s).
---
 .../families/qwen4_exp/cuda/spill.py          | 82 ++++++++++++++++---
 1 file changed, 72 insertions(+), 10 deletions(-)

diff --git a/src/tensorfold/families/qwen4_exp/cuda/spill.py b/src/tensorfold/families/qwen4_exp/cuda/spill.py
index 4adb235..19ea558 100644
--- a/src/tensorfold/families/qwen4_exp/cuda/spill.py
+++ b/src/tensorfold/families/qwen4_exp/cuda/spill.py
@@ -70,6 +70,10 @@ class SpillStore:
         self._queue: queue.Queue | None = None
         self._worker: threading.Thread | None = None
         self._lock = threading.Lock()
+        self._pool: dict[torch.dtype, list[torch.Tensor]] = {}
+        self._pool_bytes = 0
+        self._pool_lock = threading.Lock()
+        self._pool_cap = 2 * GIB
 
     # -- naming -----------------------------------------------------------------------------------------
     def name(self, ids) -> str:
@@ -92,14 +96,17 @@ class SpillStore:
         pos = int(snap["pos"])
         if pos < self.min_tokens:
             return None
-        tensors, meta = self._collect(ids, st, snap, pos, tail)
+        tensors, meta, borrowed = self._collect(ids, st, snap, pos, tail)
         self.root.mkdir(parents=True, exist_ok=True)
         path, sidecar = self._tensors(ids), self._meta(ids)
         if background:
-            self._enqueue((tensors, meta, path, sidecar))
+            self._enqueue((tensors, meta, path, sidecar, borrowed))
         else:
-            self._write(tensors, meta, path, sidecar)
-            self.trim()
+            try:
+                self._write(tensors, meta, path, sidecar)
+                self.trim()
+            finally:
+                self._release(borrowed)
         return path
 
     def _write(self, tensors: dict, meta: dict, path: Path, sidecar: Path) -> None:
@@ -131,8 +138,12 @@ class SpillStore:
             try:
                 if item is None:
                     return
-                self._write(*item)
-                self.trim()
+                tensors, meta, path, sidecar, borrowed = item
+                try:
+                    self._write(tensors, meta, path, sidecar)
+                    self.trim()
+                finally:
+                    self._release(borrowed)
             except Exception:
                 pass                       # a spill failure must never take a decode round down
             finally:
@@ -146,12 +157,62 @@ class SpillStore:
         if q is not None:
             q.join()
 
-    def _collect(self, ids, st, snap: dict, pos: int, tail) -> tuple[dict, dict]:
+    # -- staging pool -----------------------------------------------------------------------------------
+    def _borrow(self, n: int, dtype: torch.dtype) -> torch.Tensor:
+        """A flat pinned host buffer of at least ``n`` elements, reusing the smallest pooled one that fits.
+
+        The cold ``cudaHostAlloc`` dominates an eviction's GPU-to-CPU staging (its cost grows with the bytes,
+        ~0.2 s/GiB here); the cache rows' shape changes with the prefix, so re-allocating every eviction would
+        pay it again and again. Pooling a buffer and reusing it keeps the copy itself (~0.01 s/GiB on this
+        Grace-Blackwell part's coherent link) as the only cost."""
+
+        with self._pool_lock:
+            pool = self._pool.get(dtype)
+            if pool:
+                best = min((i for i, b in enumerate(pool) if b.numel() >= n),
+                           key=lambda i: pool[i].numel(), default=None)
+                if best is not None:
+                    return pool.pop(best)
+        return torch.empty(n, dtype=dtype, pin_memory=True)
+
+    def _release(self, buffers) -> None:
+        """Return staging buffers to the pool, dropping the smallest once the retained bytes exceed the cap."""
+
+        with self._pool_lock:
+            for b in buffers:
+                self._pool.setdefault(b.dtype, []).append(b)
+                self._pool_bytes += b.numel() * b.element_size()
+            while self._pool_bytes > self._pool_cap:
+                drop = None
+                for dtype, pool in self._pool.items():
+                    for i, b in enumerate(pool):
+                        nb = b.numel() * b.element_size()
+                        if drop is None or nb < drop[0]:
+                            drop = (nb, dtype, i)
+                if drop is None:
+                    break
+                nb, dtype, i = drop
+                self._pool[dtype].pop(i)
+                self._pool_bytes -= nb
+
+    def _collect(self, ids, st, snap: dict, pos: int, tail) -> tuple[dict, dict, list]:
         """The CPU tensors and metadata of one kept point: the snapshot's state, the cache rows ``[0:pos]``, the
-        MTP head's ``[0:mtp_len]`` and its tail. Copied off the GPU here, before the caller may shrink the slot."""
+        MTP head's ``[0:mtp_len]`` and its tail. Copied off the GPU here, before the caller may shrink the slot.
+
+        The copy stages through pinned host buffers drawn from the store's pool: a ``non_blocking`` D2H into a
+        reused pinned buffer, then a single synchronize. A pageable ``.to("cpu")`` blocked the eviction hot path,
+        and a fresh pinned buffer per eviction re-paid the cold allocation every time; both costs grow with the
+        prefix (measured ~4.8 s for a cold 0.6 GiB pageable copy vs ~0.22 s pinned, ~0.01 s pooled and reused).
+        The borrowed buffers ride along so ``_release`` returns them once the write has read them."""
+
+        borrowed: list[torch.Tensor] = []
 
         def cpu(t):
-            return t.detach().to("cpu").contiguous()
+            flat = self._borrow(t.numel(), t.dtype)
+            borrowed.append(flat)
+            out = flat[:t.numel()].view(t.shape)
+            out.copy_(t.detach(), non_blocking=True)
+            return out
 
         mtp_len = int(snap["mtp_len"])
         t: dict[str, torch.Tensor] = {
@@ -180,7 +241,8 @@ class SpillStore:
                 t["mtp.vs"] = cpu(st.mtp_kc.vs[:mtp_len])
             t["mtp.ikc"] = cpu(st.mtp_ikc[:mtp_len])
             t["mtp.pooled"] = cpu(st.mtp_pooled[:mtp_len // st.ratio])
-        return t, meta
+        torch.cuda.synchronize()                     # the staged copies are done before the slot may be reused
+        return t, meta, borrowed
 
     # -- reading ----------------------------------------------------------------------------------------
     def lookup(self, prompt) -> tuple[list[int], dict] | None:
-- 
