From 1f82c0c1cf24b19282c3b2f9f6df837444087345 Mon Sep 17 00:00:00 2001
From: Yuepixel <yuepixel@users.noreply.github.com>
Date: Sat, 10 Oct 2026 18:51:14 +0000
Subject: [PATCH 2/2] perf(flash next cuda): store only raw indexer keys on
 disk spill, re-pool on restore (P21d)

pooled/mtp.pooled blocks are a deterministic function of ikc (the pool kernel preserves a block bits when recomputed), so a text prefix no longer writes them; SpillStore.restore re-runs qsa_pool via a MultiDecoder.repool hook. Image prefixes keep their pooled blocks (image rotary). Cold resume is bit-identical; file shrinks by the pooled bytes (~2.4% at 31k tokens, ~39.9MB at 47k).
---
 .../families/qwen4_exp/cuda/multi.py          | 24 ++++++++++++++++++-
 .../families/qwen4_exp/cuda/spill.py          | 19 +++++++++++----
 2 files changed, 38 insertions(+), 5 deletions(-)

diff --git a/src/tensorfold/families/qwen4_exp/cuda/multi.py b/src/tensorfold/families/qwen4_exp/cuda/multi.py
index ef93b9e..0970731 100644
--- a/src/tensorfold/families/qwen4_exp/cuda/multi.py
+++ b/src/tensorfold/families/qwen4_exp/cuda/multi.py
@@ -19,7 +19,7 @@ from tensorfold.engine.grammar import GrammarError
 
 from .decode import (PREFILL_ROWS, WARM_TAIL, Engine, _gathered_fits, choose_gathered_streams,
                      entry_end, prefill_begin, tp_sample_rows)
-from . import attn_multi, gdn_multi, image_rows, prefixes
+from . import attention as attn_mod, attn_multi, gdn_multi, image_rows, prefixes
 from .forward import commit, compute, compute_mixed, converges, stage
 from .lookup import build_lookup, env_spec
 from .mtp import mtp_compute, mtp_stage
@@ -96,6 +96,8 @@ class MultiDecoder(TwoRanks, Alone, PromptPasses):
         self.kept: list[tuple[list[int], State, dict, torch.Tensor | None]] = []   # (ids, slot, snapshot, tail)
         self.keep = keep
         self.spill = spill                           # a disk store for kept prefix ends (P21), or None
+        if spill is not None:
+            spill.repool = self._repool              # the store re-pools a restored text prefix's indexer blocks
 
     def _busy(self) -> set[int]:
         return {id(s.st) for s in [*self.streams.values(), *self.filling]}
@@ -122,6 +124,26 @@ class MultiDecoder(TwoRanks, Alone, PromptPasses):
             self._spill_entry(entry)
         self._drop_kept(st)
 
+    def _repool(self, st: State, pos: int, mtp_len: int) -> None:
+        """Rebuild a restored prefix's pooled indexer blocks from its raw keys (P21d).
+
+        ``pooled`` is a deterministic function of ``ikc`` (the pool kernel preserves a block's bits when it is
+        recomputed), so a text prefix stores only the raw keys and re-pools here; a dense window keeps no blocks."""
+
+        attn = self.pbuf.attn
+        if not attn.qsa or pos <= 0:
+            return
+        w, c = self.w, self.w.cfg
+        sections = getattr(c, "mrope_section", (11, 11, 10))
+        zero = torch.zeros((1,), dtype=torch.int32, device=st.ikc[0].device)
+        for i, layer in enumerate([l for l in w.layers if not l.linear]):
+            attn_mod.qsa_pool(st.ikc[i], st.pooled[i], zero, layer.attn.ik_scale, w.inv_freq, c.eps, attn, pos,
+                              sections=sections)
+        if mtp_len and getattr(st, "mtp_kc", None) is not None:
+            layer = w.mtp.layer
+            attn_mod.qsa_pool(st.mtp_ikc, st.mtp_pooled, zero, layer.attn.ik_scale, w.inv_freq, c.eps, attn, mtp_len,
+                              sections=sections)
+
     def _grow(self, st: State, rows: int, *, alone: bool = False, protect: State | None = None) -> bool:
         """Grow caches while the gate has room; one stream may use its startup allowance within an explicit cap."""
 
diff --git a/src/tensorfold/families/qwen4_exp/cuda/spill.py b/src/tensorfold/families/qwen4_exp/cuda/spill.py
index 19ea558..2ca9ec7 100644
--- a/src/tensorfold/families/qwen4_exp/cuda/spill.py
+++ b/src/tensorfold/families/qwen4_exp/cuda/spill.py
@@ -74,6 +74,7 @@ class SpillStore:
         self._pool_bytes = 0
         self._pool_lock = threading.Lock()
         self._pool_cap = 2 * GIB
+        self.repool = None       # a MultiDecoder's (state, pos, mtp_len) hook: rebuild a text prefix's pooled blocks
 
     # -- naming -----------------------------------------------------------------------------------------
     def name(self, ids) -> str:
@@ -222,6 +223,10 @@ class SpillStore:
             t["ple_history"] = torch.from_numpy(np.ascontiguousarray(snap["ple_history"]))
         if tail is not None:
             t["tail"] = cpu(tail)
+        # the indexer's pooled blocks are a deterministic function of its raw keys (the pool kernel preserves a
+        # block's bits when it is recomputed), so a text prefix stores only ``ikc`` and re-pools on restore; an
+        # image prefix's pooled blocks carry the image rotary, which the restore path does not reconstruct.
+        pool = getattr(st, "image_positions", None) is not None
         for i, kc in enumerate(st.kc):
             t[f"kc.{i}.k"] = cpu(kc.k[:pos])
             t[f"kc.{i}.v"] = cpu(kc.v[:pos])
@@ -229,7 +234,8 @@ class SpillStore:
                 t[f"kc.{i}.ks"] = cpu(kc.ks[:pos])
                 t[f"kc.{i}.vs"] = cpu(kc.vs[:pos])
             t[f"ikc.{i}"] = cpu(st.ikc[i][:pos])
-            t[f"pooled.{i}"] = cpu(st.pooled[i][:pos // st.ratio])
+            if pool:
+                t[f"pooled.{i}"] = cpu(st.pooled[i][:pos // st.ratio])
         meta = {"ids": ids, "pos": pos, "mtp_len": mtp_len, "kv_dtype": st.kv_dtype, "ratio": st.ratio,
                 "layers": len(st.kc), "quantized": bool(st.kc and st.kc[0].quantized), "mtp": hasattr(st, "mtp_kc"),
                 "ple": snap["ple_history"] is not None, "tail": tail is not None, "saved": time.time()}
@@ -240,7 +246,8 @@ class SpillStore:
                 t["mtp.ks"] = cpu(st.mtp_kc.ks[:mtp_len])
                 t["mtp.vs"] = cpu(st.mtp_kc.vs[:mtp_len])
             t["mtp.ikc"] = cpu(st.mtp_ikc[:mtp_len])
-            t["mtp.pooled"] = cpu(st.mtp_pooled[:mtp_len // st.ratio])
+            if pool:
+                t["mtp.pooled"] = cpu(st.mtp_pooled[:mtp_len // st.ratio])
         torch.cuda.synchronize()                     # the staged copies are done before the slot may be reused
         return t, meta, borrowed
 
@@ -292,7 +299,8 @@ class SpillStore:
                 into(dst.kc[i].ks[:pos], f"kc.{i}.ks")
                 into(dst.kc[i].vs[:pos], f"kc.{i}.vs")
             dst.ikc[i][:pos].copy_(t[f"ikc.{i}"].to(dst.ikc[i].device))
-            dst.pooled[i][:pos // dst.ratio].copy_(t[f"pooled.{i}"].to(dst.pooled[i].device))
+            if f"pooled.{i}" in t:
+                dst.pooled[i][:pos // dst.ratio].copy_(t[f"pooled.{i}"].to(dst.pooled[i].device))
         if mtp_len and hasattr(dst, "mtp_kc"):
             into(dst.mtp_kc.k[:mtp_len], "mtp.k")
             into(dst.mtp_kc.v[:mtp_len], "mtp.v")
@@ -300,7 +308,10 @@ class SpillStore:
                 into(dst.mtp_kc.ks[:mtp_len], "mtp.ks")
                 into(dst.mtp_kc.vs[:mtp_len], "mtp.vs")
             dst.mtp_ikc[:mtp_len].copy_(t["mtp.ikc"].to(dst.mtp_ikc.device))
-            dst.mtp_pooled[:mtp_len // dst.ratio].copy_(t["mtp.pooled"].to(dst.mtp_pooled.device))
+            if "mtp.pooled" in t:
