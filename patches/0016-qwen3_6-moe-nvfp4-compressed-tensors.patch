+"""Qwen3.6 MoE on CUDA: NVFP4 checkpoints (ModelOpt, compressed-tensors) are read; Macs keep the MLX rule."""
+
+import json
+
+import pytest
+
+from tensorfold import families
+from tensorfold.families import qwen3_5_moe
+
+UNIFORM = {"model_type": "qwen3_5_moe", "quantization": {"bits": 4, "group_size": 64, "mode": "affine"},
+           "text_config": {"model_type": "qwen3_5_moe_text"}}
+MIXED = {"model_type": "qwen3_5_moe", "quantization": {"bits": 8, "group_size": 64, "mode": "affine"},
+         "text_config": {"model_type": "qwen3_5_moe_text"}}
+UNQUANTIZED = {"model_type": "qwen3_5_moe", "text_config": {"model_type": "qwen3_5_moe_text"}}
+MODELOPT = {"model_type": "qwen3_5_moe", "text_config": {
+    "model_type": "qwen3_5_moe_text",
+    "quantization_config": {"quant_method": "modelopt", "quant_algo": "NVFP4",
+                            "config_groups": {"group_0": {"weights": {"num_bits": 4, "type": "float"}}}}}}
+COMPRESSED = {"model_type": "qwen3_5_moe", "text_config": {
+    "model_type": "qwen3_5_moe_text",
+    "quantization_config": {"quant_method": "compressed-tensors", "format": "nvfp4-pack-quantized",
+                            "config_groups": {"group_0": {"weights": {"num_bits": 4, "type": "float"}}}}}}
+FP8 = {"model_type": "qwen3_5_moe", "text_config": {
+    "model_type": "qwen3_5_moe_text",
+    "quantization_config": {"quant_method": "compressed-tensors", "format": "float-quantized",
+                            "config_groups": {"group_0": {"weights": {"num_bits": 8, "type": "float"}}}}}}
+INT4 = {"model_type": "qwen3_5_moe", "text_config": {
+    "model_type": "qwen3_5_moe_text",
+    "quantization_config": {"quant_method": "compressed-tensors", "format": "nvfp4-pack-quantized",
+                            "config_groups": {"group_0": {"weights": {"num_bits": 4, "type": "int"}}}}}}    # int, not float
+
+
+def _config(tmp_path, config):
+    (tmp_path / "config.json").write_text(json.dumps(config))
+    return tmp_path
+
+
+@pytest.mark.parametrize("config", [MODELOPT, COMPRESSED, FP8])
+def test_the_cuda_engine_reads_nvfp4_and_fp8(tmp_path, config):
+    families.require_readable(families.detect(_config(tmp_path, config)), config, "cuda")
+    qwen3_5_moe.check(_config(tmp_path, config))
+
+
+def test_the_mlx_rule_still_holds_on_cuda(tmp_path):
+    qwen3_5_moe.check(_config(tmp_path, UNIFORM))
+    with pytest.raises(ValueError, match="groups of 64"):
+        qwen3_5_moe.check(_config(tmp_path, MIXED))
+
+
+def test_macs_keep_the_mlx_rule_and_refuse_nvfp4(tmp_path):
+    families.require_readable(families.detect(_config(tmp_path, UNIFORM)), UNIFORM, "mlx")
+    with pytest.raises(ValueError, match="does not read"):
+        families.require_readable(families.detect(_config(tmp_path, COMPRESSED)), COMPRESSED, "mlx")
+
+
+def test_cuda_refuses_unreadable_weights(tmp_path):
+    with pytest.raises(ValueError, match="does not read"):
+        families.require_readable(families.detect(_config(tmp_path, UNQUANTIZED)), UNQUANTIZED, "cuda")
+    with pytest.raises(ValueError, match="int weights"):
+        families.require_readable(families.detect(_config(tmp_path, INT4)), INT4, "cuda")
+
+
+def test_the_engine_takes_nvfp4_directories(tmp_path, monkeypatch):
+    from tensorfold.families.qwen3_5_moe.cuda import engine
+
+    made = {}
+    monkeypatch.setattr(engine, "Qwen36Engine", lambda path, **kw: made.update(kw) or "engine")
+    assert qwen3_5_moe.cuda_engine(_config(tmp_path, COMPRESSED)) == "engine"
+    assert made["depth"] == 3
