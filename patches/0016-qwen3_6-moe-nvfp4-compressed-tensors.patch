+def load_mtp_nvfp4(model_dir: str | Path, w: Weights, device: str = "cuda", ids=None) -> MTP | None:
+    """An NVFP4 export's bf16 MTP layer (``model-mtp.safetensors``) with its experts quantized on load.
+
+    The side file keeps fc, the one attention layer and every norm in bf16; its routed experts arrive fused
+    (``experts.gate_up_proj`` and ``experts.down_proj``), so they are NVFP4-quantized here and the shared expert joins
+    as the last row, matching ``routed4`` and the model's own layers.
+    """
+
+    from tensorfold.cuda.nvfp4 import experts as nvx
+
+    raw = mtp_tensors(model_dir)
+    if raw is None:
+        return None
+
+    def get(name: str) -> torch.Tensor:
+        return raw.pop("mtp." + name).to(device)
+
+    def plain(name: str) -> QLinear:
+        return QLinear(get(name + ".weight").to(torch.bfloat16).contiguous(), None, None, layout="dense", bits=0, gs=0)
+
+    def norm(name: str) -> torch.Tensor:
+        v = get(name)
+        return (v.float() + 1.0).to(v.dtype).contiguous()      # the export writes gamma - 1, as the text model does
+
+    d = w.config.hidden
+    fc = get("fc.weight").to(torch.bfloat16)
+    p = "layers.0."
+    attn = Attention(q=plain(p + "self_attn.q_proj"), k=plain(p + "self_attn.k_proj"),
+                     v=plain(p + "self_attn.v_proj"), o=plain(p + "self_attn.o_proj"),
+                     q_norm=norm(p + "self_attn.q_norm.weight"), k_norm=norm(p + "self_attn.k_norm.weight"))
+    m = MTP(norm_e=norm("pre_fc_norm_embedding.weight"), norm_h=norm("pre_fc_norm_hidden.weight"),
+            fc_e=QLinear(fc[:, :d].contiguous(), None, None, layout="dense", bits=0, gs=0),
+            fc_h=QLinear(fc[:, d:].contiguous(), None, None, layout="dense", bits=0, gs=0),
+            input_norm=norm(p + "input_layernorm.weight"), post_norm=norm(p + "post_attention_layernorm.weight"),
+            attn=attn, moe=_mtp_moe(get, w.config), norm=norm("norm.weight"), head=w.head)
+    if raw:
+        raise ValueError(f"unused MTP tensors: {sorted(raw)[:5]}")
+    return m
+
+
+def _mtp_moe(get: Callable, cfg) -> Routed:
+    """The MTP layer's routed experts (fused bf16) plus its shared expert, NVFP4-quantized into one table."""
+
+    from tensorfold.cuda.nvfp4 import experts as nvx
+
+    gu = get("layers.0.mlp.experts.gate_up_proj").to(torch.bfloat16)
+    dn = get("layers.0.mlp.experts.down_proj").to(torch.bfloat16)
+    half = gu.shape[1] // 2
+    parts = [nvx.quantize(gu[:, :half].contiguous()), nvx.quantize(gu[:, half:].contiguous()), nvx.quantize(dn)]
+    sh = [nvx.quantize(get(f"layers.0.mlp.shared_expert.{proj}_proj.weight").to(torch.bfloat16)[None])
+          for proj in ("gate", "up", "down")]
+    tables = [tuple(torch.cat([a, b]) for a, b in zip(part, shared)) for part, shared in zip(parts, sh)]
+    router = torch.cat([get("layers.0.mlp.gate.weight").to(torch.bfloat16),
+                        get("layers.0.mlp.shared_expert_gate.weight").to(torch.bfloat16)])
+    return Routed(router.contiguous(), nvx.make(*tables), int(cfg.top_k))
