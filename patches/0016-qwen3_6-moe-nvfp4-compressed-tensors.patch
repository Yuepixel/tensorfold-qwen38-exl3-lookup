+def routed4(prefix: str, t, cfg) -> dict:
+    """A layer's NVFP4 (ModelOpt or compressed-tensors) routed experts for the grouped kernel.
+
+    The routed experts are stored one tensor a projection; the shared expert, quantized in the same scheme, becomes
+    the last row (index ``num_experts``) exactly as the MLX path stacks ``switch_mlp`` with ``shared_expert``.
+    """
+
+    from tensorfold.cuda.nvfp4 import experts as nvx
+
+    def read(name: str) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        """One projection's packed words, e4m3 scales and the per-expert global scale (compressed-tensors stores its
+        reciprocal)."""
+
+        if name + ".weight_global_scale" in t:
+            g = 1.0 / t.pop(name + ".weight_global_scale").float().reshape(-1)[0]
+        elif name + ".weight_scale_2" in t:
+            g = t.pop(name + ".weight_scale_2").float().reshape(-1)[0]
+        else:
+            g = torch.ones((), dtype=torch.float32, device=t.device)
+        w = t.pop(name + ".weight_packed") if name + ".weight_packed" in t else t.pop(name + ".weight")
+        s = t.pop(name + ".weight_scale")
+        for extra in ("input_global_scale", "input_scale"):
+            if name + "." + extra in t:
+                t.pop(name + "." + extra)
+        return w.view(torch.uint8).contiguous(), s.contiguous(), g.to(torch.float32)
+
+    def table(proj: str) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        rows = [read(f"{prefix}experts.{e}.{proj}") for e in range(int(cfg.experts))]
+        rows.append(read(f"{prefix}shared_expert.{proj}"))
+        return (torch.stack([r[0] for r in rows]), torch.stack([r[1] for r in rows]),
+                torch.stack([r[2] for r in rows]))
+
+    router = torch.cat([t.pop(prefix + "gate.weight"), t.pop(prefix + "shared_expert_gate.weight")])
+    experts = nvx.make(table("gate_proj"), table("up_proj"), table("down_proj"))
+    return {"moe": Routed(router.to(torch.bfloat16).contiguous(), experts, int(cfg.top_k))}
+
+
