+    down_arr, down_info = get.raw(prefix + "switch_mlp.down_proj.weight")
+    device = router.device
+    experts = GgufExperts(torch.from_numpy(gate_arr).to(device), torch.from_numpy(up_arr).to(device),
+                          torch.from_numpy(down_arr).to(device), gate_info.quant, down_info.quant,
+                          get(prefix + "shared_expert.gate_proj.weight"),
+                          get(prefix + "shared_expert.up_proj.weight"),
+                          get(prefix + "shared_expert.down_proj.weight"))
+    return Routed(router, experts, int(top_k))
+
