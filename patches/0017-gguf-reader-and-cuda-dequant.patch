index 95b7bcd..3b63285 100644
--- a/src/tensorfold/cuda/kernels/affine_kernels.py
+++ b/src/tensorfold/cuda/kernels/affine_kernels.py
@@ -46,6 +46,84 @@ def dense(X, W, OUT, N: tl.constexpr, K: tl.constexpr, BLOCK: tl.constexpr):
     tl.store(OUT + row * N + cols, acc, mask=cols < N)
 
 
+# GGUF (ggml) block formats. The CUDA engine keeps the raw quantized blocks on the GPU and
+# reconstructs each block's values inside the matmul, so a GGUF projection never holds a bf16 copy.
+# type -> (enum, elements per block, bytes per block)
+GGML_BLOCK = {"q8_0": (0, 32, 34), "q4_k": (1, 256, 144), "q5_k": (2, 256, 176), "q6_k": (3, 256, 210)}
+
+
+@triton.jit
+def _f16(lo, hi):
+    return (lo.to(tl.uint16) | (hi.to(tl.uint16) << 8)).to(tl.float16, bitcast=True).to(tl.float32)
+
+
+@triton.jit
+def ggml(X, W, OUT, M, RB, N: tl.constexpr, K: tl.constexpr, BLK: tl.constexpr, BYTES: tl.constexpr,
+         QT: tl.constexpr):
+    """x [M, K] bf16 against a GGUF [N, K] weight whose raw blocks are dequantized here, 16 rows x 32 outputs a tile."""
+
+    rows = tl.program_id(0) * 16 + tl.arange(0, 16)
+    cols = tl.program_id(1) * 32 + tl.arange(0, 32)
+    colok = cols < N
+    base0 = cols[:, None] * RB
+    j = tl.arange(0, BLK)
+    acc = tl.zeros((16, 32), tl.float32)
+    for b in range(0, K // BLK):
+        xk = b * BLK + j
+        x = tl.load(X + rows[:, None] * K + xk[None, :], mask=rows[:, None] < M, other=0)
+        base = base0 + b * BYTES
+        if QT == 0:                                                # Q8_0: d f16, then 32 int8
+            d = _f16(tl.load(W + base), tl.load(W + base + 1))
+            qb = tl.load(W + base + 2 + j[None, :], mask=colok[:, None], other=0).to(tl.int8, bitcast=True)
+            wv = d * qb.to(tl.float32)
+        elif QT == 1:                                              # Q4_K: d, dmin f16, 12 scale bytes, 128 nibbles
+            d = _f16(tl.load(W + base), tl.load(W + base + 1))
+            dmin = _f16(tl.load(W + base + 2), tl.load(W + base + 3))
+            s8 = tl.arange(0, 8)
+            t = tl.where(s8 < 4, s8, s8 - 4)
+            bt = tl.load(W + base + 4 + t[None, :], mask=colok[:, None], other=0)
+            b4 = tl.load(W + base + 8 + t[None, :], mask=colok[:, None], other=0)
+            b8 = tl.load(W + base + 12 + t[None, :], mask=colok[:, None], other=0)
+            sc = tl.where(s8[None, :] < 4, bt & 0x3F, (b8 & 0x0F) | ((bt >> 2) & 0x30))
+            mm = tl.where(s8[None, :] < 4, b4 & 0x3F, (b8 >> 4) | ((b4 >> 2) & 0x30))
+            Sce = tl.reshape(tl.broadcast_to(sc[:, :, None], (32, 8, BLK // 8)), (32, BLK)).to(tl.float32)
+            Mme = tl.reshape(tl.broadcast_to(mm[:, :, None], (32, 8, BLK // 8)), (32, BLK)).to(tl.float32)
+            g, wb, sub = j // 64, j % 32, (j // 32) % 2
+            qb = tl.load(W + base + 16 + (g * 32 + wb)[None, :], mask=colok[:, None], other=0)
+            q = (qb >> (sub * 4)[None, :]) & 0xF
+            wv = d * Sce * q.to(tl.float32) - dmin * Mme
+        elif QT == 2:                                              # Q5_K: as Q4_K plus a 32-byte high-bit plane
+            d = _f16(tl.load(W + base), tl.load(W + base + 1))
+            dmin = _f16(tl.load(W + base + 2), tl.load(W + base + 3))
+            s8 = tl.arange(0, 8)
+            t = tl.where(s8 < 4, s8, s8 - 4)
+            bt = tl.load(W + base + 4 + t[None, :], mask=colok[:, None], other=0)
+            b4 = tl.load(W + base + 8 + t[None, :], mask=colok[:, None], other=0)
+            b8 = tl.load(W + base + 12 + t[None, :], mask=colok[:, None], other=0)
+            sc = tl.where(s8[None, :] < 4, bt & 0x3F, (b8 & 0x0F) | ((bt >> 2) & 0x30))
+            mm = tl.where(s8[None, :] < 4, b4 & 0x3F, (b8 >> 4) | ((b4 >> 2) & 0x30))
+            Sce = tl.reshape(tl.broadcast_to(sc[:, :, None], (32, 8, BLK // 8)), (32, BLK)).to(tl.float32)
+            Mme = tl.reshape(tl.broadcast_to(mm[:, :, None], (32, 8, BLK // 8)), (32, BLK)).to(tl.float32)
+            g, wb, sub = j // 64, j % 32, (j // 32) % 2
+            qb = tl.load(W + base + 48 + (g * 32 + wb)[None, :], mask=colok[:, None], other=0)
+            qh = tl.load(W + base + 16 + wb[None, :], mask=colok[:, None], other=0)
+            q = ((qb >> (sub * 4)[None, :]) & 0xF) | (((qh >> (j // 32)[None, :]) & 1) << 4)
+            wv = d * Sce * q.to(tl.float32) - dmin * Mme
+        else:                                                      # Q6_K: 16 sub-scales, 128 low nibbles, 64 2-bit planes
+            a, rem = j // 128, j % 128
+            bb, c, db, w2 = rem // 64, rem % 64, rem // 32, j % 32
+            ql = tl.load(W + base + (a * 64 + c)[None, :], mask=colok[:, None], other=0)
+            nib = (ql >> (bb * 4)[None, :]) & 0xF
+            qh = tl.load(W + base + 128 + (a * 32 + w2)[None, :], mask=colok[:, None], other=0)
+            hi = (qh >> (db * 2)[None, :]) & 3
+            q = ((nib | (hi << 4)).to(tl.int32) - 32).to(tl.float32)
+            sc = tl.load(W + base + 192 + (j // 16)[None, :], mask=colok[:, None], other=0)
+            d = _f16(tl.load(W + base + 208), tl.load(W + base + 209))
+            wv = d * sc.to(tl.int8, bitcast=True).to(tl.float32) * q
+        acc += tl.dot(x, tl.trans(wv.to(tl.bfloat16)), input_precision="ieee")
+    tl.store(OUT + rows[:, None] * N + cols[None, :], acc, mask=(rows[:, None] < M) & colok[None, :])
+
+
