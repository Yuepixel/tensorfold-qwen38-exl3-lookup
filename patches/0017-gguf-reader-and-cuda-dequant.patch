diff --git a/tests/test_gguf_cuda_ggml.py b/tests/test_gguf_cuda_ggml.py
new file mode 100644
index 0000000..1b1cd55
--- /dev/null
+++ b/tests/test_gguf_cuda_ggml.py
@@ -0,0 +1,58 @@
+"""The fused GGUF dequant+matmul CUDA kernel must reproduce the CPU dequantizer bit-for-bit in bf16."""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.gguf.dequant import DEQUANTIZERS
+from tensorfold.cuda.kernels import affine
+from tensorfold.families.qwen3_5.cuda.weights import QLinear
+
+BLOCKS = {"q8_0": (32, 34), "q4_k": (256, 144), "q5_k": (256, 176), "q6_k": (256, 210)}
+
+
+def _raw(qtype: str, n: int, k: int) -> np.ndarray:
+    blk, byt = BLOCKS[qtype]
+    rng = np.random.default_rng(1234)
+    nb = k // blk
+    raw = rng.integers(0, 256, size=(n, nb * byt), dtype=np.uint8)
+    scale = np.float16(0.02)
+    for row in range(n):
+        for b in range(nb):
+            base = b * byt
+            if qtype == "q8_0":
+                raw[row, base:base + 2] = np.frombuffer(scale.tobytes(), dtype=np.uint8)
+            elif qtype == "q6_k":
+                raw[row, base + 208:base + 210] = np.frombuffer(scale.tobytes(), dtype=np.uint8)
+            else:
+                raw[row, base:base + 2] = np.frombuffer(scale.tobytes(), dtype=np.uint8)
+                raw[row, base + 2:base + 4] = np.frombuffer(np.float16(0.01).tobytes(), dtype=np.uint8)
+    return raw
+
+
+@pytest.mark.parametrize("qtype", list(BLOCKS))
+def test_ggml_matmul_matches_dequant(qtype):
+    if not torch.cuda.is_available():
+        pytest.skip("needs CUDA")
+    blk, byt = BLOCKS[qtype]
+    n, k, m = 64, 512, 32
+    raw = _raw(qtype, n, k)
+    ref = DEQUANTIZERS[qtype](raw, (n, k))
+    assert ref.shape == (n, k)
+
+    held = torch.from_numpy(raw).cuda().reshape(n, k // blk, byt).contiguous()
+    q = QLinear(held, None, None, layout="ggml", qtype=qtype, qblock=blk, qbytes=byt)
+    assert (q.n, q.k) == (n, k)
+
+    x = torch.randn(m, k, device="cuda", dtype=torch.bfloat16)
+    out = affine.matmul(x, q).float()
+
+    wb = torch.from_numpy(ref).cuda().bfloat16().float()
+    want = x.float() @ wb.T
+    err = (out - want).abs().max().item()
+    # ``out`` is BF16 while ``want`` stays F32, so the gap is the output's own BF16 rounding.
+    tol = 0.03 * want.abs().max().item() + 0.05
+    assert err < tol, f"{qtype} max abs error {err} (tol {tol})"
