+"""GGUF block dequantization to f32; Q8_0 first, matching llama.cpp's block_q8_0 layout."""
+from __future__ import annotations
+
+import numpy as np
+from numpy.typing import NDArray
+
+QK8_0 = 32
+BLOCK_Q8_0 = np.dtype([("d", "<f2"), ("qs", "i1", (QK8_0,))])
+
+
+def dequantize_q8_0(raw: NDArray, shape: tuple[int, ...]) -> NDArray[np.float32]:
+    """Dequantize Q8_0 blocks (ggml_half scale + int8[32]) to f32 of ``shape``."""
+    n_elements = int(np.prod(shape))
+    if n_elements % QK8_0:
+        raise ValueError(f"Q8_0 element count {n_elements} is not a multiple of {QK8_0}")
+    blocks = _blocks(raw, BLOCK_Q8_0, n_elements // QK8_0)
+    scales = blocks["d"].astype(np.float32)
+    values = blocks["qs"].astype(np.float32)
+    return (scales[:, None] * values).reshape(shape)
+
+
+def _blocks(raw: NDArray, dtype: np.dtype, n_blocks: int) -> NDArray:
+    flat = np.ascontiguousarray(raw, dtype=np.uint8).reshape(-1)
+    if flat.size != n_blocks * dtype.itemsize:
+        raise ValueError(f"expected {n_blocks * dtype.itemsize} bytes, got {flat.size}")
+    return flat.view(dtype)
+
+
+DEQUANTIZERS = {"q8_0": dequantize_q8_0}
+
+__all__ = ["BLOCK_Q8_0", "DEQUANTIZERS", "QK8_0", "dequantize_q8_0"]
diff --git a/src/tensorfold/gguf/reader.py b/src/tensorfold/gguf/reader.py
new file mode 100644
index 0000000..68d6709
--- /dev/null
+++ b/src/tensorfold/gguf/reader.py
@@ -0,0 +1,102 @@
+"""GGUF checkpoints read through the ``gguf`` reference package: mmap, metadata and a tensor index."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+
+import numpy as np
+from numpy.typing import NDArray
+
+from .dequant import DEQUANTIZERS
+
+
+@dataclass(frozen=True)
+class GgufTensor:
+    """One entry of a GGUF tensor index, in logical (row-major) shape."""
+
+    name: str
+    shape: tuple[int, ...]
+    quant: str
+    n_bytes: int
+    offset: int
+
+
+def _logical_shape(tensor) -> tuple[int, ...]:
+    return tuple(int(d) for d in reversed(tensor.shape.tolist()))
+
+
+class GgufReader:
+    """Memory-mapped GGUF reader: metadata fields, a tensor index and block dequantization.
+
+    Wraps :class:`gguf.GGUFReader`, which memmaps the file and parses the header, so the
+    package is imported lazily and only required for actual GGUF access.
+    """
+
+    def __init__(self, path: str | Path):
+        from gguf import GGUFReader
+
+        self.path = Path(path)
+        self._reader = GGUFReader(str(self.path))
+        self._fields = self._reader.fields
+        self._tensors = {t.name: t for t in self._reader.tensors}
+
+    @property
+    def architecture(self) -> str | None:
+        return self.field("general.architecture")
+
+    def field(self, key: str, default=None):
+        value = self._reader.get_field(key)
+        return default if value is None else value.contents()
+
+    def fields(self) -> list[str]:
+        return list(self._fields)
+
+    def keys(self) -> list[str]:
+        return list(self._tensors)
+
+    def __contains__(self, name: str) -> bool:
+        return name in self._tensors
+
+    def __len__(self) -> int:
+        return len(self._tensors)
+
+    def info(self, name: str) -> GgufTensor:
+        tensor = self._tensors[name]
+        return GgufTensor(
+            name=tensor.name,
+            shape=_logical_shape(tensor),
+            quant=tensor.tensor_type.name.lower(),
+            n_bytes=int(tensor.n_bytes),
+            offset=int(tensor.data_offset),
+        )
+
+    def raw(self, name: str) -> NDArray:
+        """The tensor's stored bytes (or native dtype for F32/F16) as a memory-mapped view."""
+        return np.asarray(self._tensors[name].data)
+
+    def dequant(self, name: str) -> NDArray[np.float32]:
+        """Materialize ``name`` as float32, dequantizing supported GGUF block types."""
+        tensor = self._tensors[name]
+        kind = tensor.tensor_type.name.lower()
+        if kind in DEQUANTIZERS:
+            return DEQUANTIZERS[kind](tensor.data, _logical_shape(tensor))
+        if kind == "f32":
+            return np.asarray(tensor.data, dtype=np.float32).reshape(_logical_shape(tensor))
+        if kind == "f16":
+            return np.asarray(tensor.data, dtype=np.float16).astype(np.float32).reshape(_logical_shape(tensor))
+        raise NotImplementedError(f"tensor {name!r} uses GGUF type {kind!r}, which is not supported yet")
+
+    def close(self) -> None:
+        data = getattr(self._reader, "data", None)
+        mmap = getattr(data, "_mmap", None)
+        if mmap is not None:
+            mmap.close()
+
+    def __enter__(self) -> "GgufReader":
+        return self
+
+    def __exit__(self, *exc) -> None:
+        self.close()
+
+
+__all__ = ["GgufReader", "GgufTensor"]
diff --git a/tests/test_gguf_q8_0.py b/tests/test_gguf_q8_0.py
new file mode 100644
index 0000000..d676be0
--- /dev/null
+++ b/tests/test_gguf_q8_0.py
@@ -0,0 +1,42 @@
+from __future__ import annotations
+
+import numpy as np
+import pytest
+from gguf import GGMLQuantizationType
+from gguf.quants import Q8_0
+
+from tensorfold.gguf.dequant import BLOCK_Q8_0, QK8_0, dequantize_q8_0
+
+
+def test_block_layout_matches_ggml():
+    assert QK8_0 == 32
+    assert BLOCK_Q8_0.itemsize == 34
+    assert GGMLQuantizationType.Q8_0.value == 8
+
+
+def test_dequantize_matches_reference_bitwise():
+    rng = np.random.default_rng(1234)
+    blocks = rng.integers(0, 256, size=(5, BLOCK_Q8_0.itemsize), dtype=np.uint8)
+    ours = dequantize_q8_0(blocks, (5 * QK8_0,))
+    reference = Q8_0.dequantize_blocks(blocks).reshape(-1)
+    assert ours.dtype == np.float32
+    assert np.array_equal(ours, reference)
+
+
+def test_round_trip_error_is_small():
+    rng = np.random.default_rng(7)
+    values = (rng.standard_normal((4, QK8_0)) * 3).astype(np.float32)
+    blocks = Q8_0.quantize_blocks(values)
+    restored = dequantize_q8_0(blocks, values.shape)
+    assert restored.shape == values.shape
+    assert np.abs(restored - values).max() <= np.abs(values).max() / 127 + 1e-4
+
+
+def test_rejects_misaligned_element_count():
+    with pytest.raises(ValueError):
+        dequantize_q8_0(np.zeros(33, dtype=np.uint8), (48,))
+
+
+def test_rejects_wrong_byte_count():
+    with pytest.raises(ValueError):
+        dequantize_q8_0(np.zeros(10, dtype=np.uint8), (32,))
diff --git a/tests/test_gguf_reader.py b/tests/test_gguf_reader.py
new file mode 100644
index 0000000..639d3d0
--- /dev/null
+++ b/tests/test_gguf_reader.py
@@ -0,0 +1,75 @@
+from __future__ import annotations
+
+import numpy as np
+import pytest
+from gguf import GGMLQuantizationType, GGUFWriter
+from gguf.quants import Q4_0, Q8_0
+
+from tensorfold.gguf import GgufReader
+
+
+def _write_sample(path):
+    weights = ((np.arange(96, dtype=np.float32).reshape(3, 32) - 48) / 10).astype(np.float32)
+    blocks = Q8_0.quantize_blocks(weights)
+    norm = np.linspace(-1.0, 1.0, 8, dtype=np.float32).reshape(2, 4)
+
+    writer = GGUFWriter(path, "qwen3_5_moe")
+    writer.add_name("synthetic-qwen3_5_moe")
+    writer.add_block_count(2)
+    writer.add_tensor("blk.0.attn_q.weight", blocks, raw_dtype=GGMLQuantizationType.Q8_0)
+    writer.add_tensor("blk.0.attn_norm.weight", norm)
+    writer.write_header_to_file()
+    writer.write_kv_data_to_file()
+    writer.write_tensors_to_file()
+    writer.close()
+    return weights, norm
+
+
+def test_metadata_and_tensor_index(tmp_path):
+    weights, _ = _write_sample(tmp_path / "sample.gguf")
+    with GgufReader(tmp_path / "sample.gguf") as reader:
+        assert reader.architecture == "qwen3_5_moe"
+        assert reader.field("general.name") == "synthetic-qwen3_5_moe"
+        assert reader.field("qwen3_5_moe.block_count") == 2
+        assert reader.field("missing.key", "fallback") == "fallback"
+        assert set(reader.keys()) == {"blk.0.attn_q.weight", "blk.0.attn_norm.weight"}
+        assert "blk.0.attn_q.weight" in reader
+        assert len(reader) == 2
+
+        info = reader.info("blk.0.attn_q.weight")
+        assert info.shape == (3, 32)
+        assert info.quant == "q8_0"
+        assert info.n_bytes == 3 * 34
+
+        raw = reader.raw("blk.0.attn_q.weight")
+        assert raw.dtype == np.uint8
+        assert raw.shape == (3, 34)
+
+        restored = reader.dequant("blk.0.attn_q.weight")
+        assert restored.shape == (3, 32)
+        assert np.abs(restored - weights).max() <= np.abs(weights).max() / 127 + 1e-4
+
+
+def test_f32_tensor_passthrough(tmp_path):
+    _, norm = _write_sample(tmp_path / "sample.gguf")
+    with GgufReader(tmp_path / "sample.gguf") as reader:
+        info = reader.info("blk.0.attn_norm.weight")
+        assert info.quant == "f32"
+        assert info.shape == (2, 4)
+        f32 = reader.dequant("blk.0.attn_norm.weight")
+        assert f32.dtype == np.float32
+        assert np.array_equal(f32, norm)
+
+
+def test_unsupported_quant_raises(tmp_path):
+    blocks = Q4_0.quantize_blocks(np.zeros((2, 32), dtype=np.float32))
+    writer = GGUFWriter(tmp_path / "q4.gguf", "qwen3_5_moe")
+    writer.add_tensor("blk.0.attn_q.weight", blocks, raw_dtype=GGMLQuantizationType.Q4_0)
+    writer.write_header_to_file()
+    writer.write_kv_data_to_file()
+    writer.write_tensors_to_file()
+    writer.close()
+    with GgufReader(tmp_path / "q4.gguf") as reader:
+        assert reader.info("blk.0.attn_q.weight").quant == "q4_0"
+        with pytest.raises(NotImplementedError):
+            reader.dequant("blk.0.attn_q.weight")
