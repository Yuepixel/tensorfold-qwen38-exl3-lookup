index 0000000..6f171ce
--- /dev/null
+++ b/src/tensorfold/gguf/tokenizer.py
@@ -0,0 +1,157 @@
+"""Synthesize a Hugging Face ``tokenizer.json`` from a GGUF file's embedded tokenizer metadata.
+
+A GGUF file carries its vocabulary (``tokenizer.ggml.tokens``), merge rules
+(``tokenizer.ggml.merges``), special-token ids and chat template under llama.cpp keys,
+but TensorFold's CUDA server loads a Hugging Face ``tokenizer.json`` from the model
+directory. This module rebuilds that file (and a small ``tokenizer_config.json``) so a
+bare GGUF directory needs no hand-copied sidecar.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from .hf import open_file
+
+# llama.cpp tokenizer.ggml.token_type: 1=NORMAL, 2=UNKNOWN, 3=CONTROL, 4=USER_DEFINED,
+# 5=UNUSED, 6=BYTE.
+_CONTROL = 3
+_USER_DEFINED = 4
+_UNUSED = 5
+
+# The Qwen2 pre-tokenizer regex (matches the HF Qwen tokenizer.json): letters stay word-initial
+# with one preceding punctuation byte, digits are isolated per byte, so BPE can merge '(x' etc.
+_QWEN_SPLIT_RE = (r"(?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\r\n\p{L}\p{N}]?\p{L}+|\p{N}"
+                  r"| ?[^\s\p{L}\p{N}]+[\r\n]*|\s*[\r\n]+|\s+(?!\S)|\s+")
+
+
+def _as_list(value) -> list:
+    if value is None:
+        return []
+    if isinstance(value, str):
+        return [value]
+    try:
+        return list(value)
+    except TypeError:                                # a scalar metadata value (e.g. a numpy int)
+        return [value]
+
+
+def build_tokenizer_json(reader) -> dict:
+    """A Hugging Face ``tokenizer.json`` dict for a GPT-2-style (byte-level BPE) GGUF tokenizer."""
+
+    tokens = [str(t) for t in _as_list(reader.field("tokenizer.ggml.tokens"))]
+    if not tokens:
+        raise ValueError("GGUF file carries no tokenizer.ggml.tokens")
+    types = [int(t) for t in _as_list(reader.field("tokenizer.ggml.token_type"))]
+    merges = [str(m) for m in _as_list(reader.field("tokenizer.ggml.merges"))]
+
+    vocab: dict[str, int] = {}
+    for i, token in enumerate(tokens):
+        token_type = types[i] if i < len(types) else 1
+        if token_type == _UNUSED:                    # llama.cpp marks padding slots 5=UNUSED; they are not real tokens
+            continue
+        vocab[token] = i
+
+    special_ids: set[int] = set()
+    for kind, token_type in zip(tokens, types):
+        if token_type in (_CONTROL, _USER_DEFINED):
+            special_ids.add(vocab[kind])
+    for key in ("tokenizer.ggml.bos_token_id", "tokenizer.ggml.eos_token_id", "tokenizer.ggml.padding_token_id"):
+        for tid in _as_list(reader.field(key)):
+            special_ids.add(int(tid))
+
+    added_tokens = [
+        {"id": i, "content": tokens[i], "single_word": False, "lstrip": False,
+         "rstrip": False, "normalized": False, "special": True}
+        for i in sorted(special_ids) if 0 <= i < len(tokens)
+    ]
+
+    return {
+        "version": "1.0",
+        "truncation": None,
+        "padding": None,
+        "added_tokens": added_tokens,
+        "normalizer": {"type": "NFC"},
+        "pre_tokenizer": {"type": "Sequence", "pretokenizers": [
+            {"type": "Split", "pattern": {"Regex": _QWEN_SPLIT_RE}, "behavior": "Isolated", "invert": False},
+            {"type": "ByteLevel", "add_prefix_space": False, "trim_offsets": True, "use_regex": False},
+        ]},
+        "post_processor": None,
+        "decoder": {"type": "ByteLevel", "add_prefix_space": True,
+                    "trim_offsets": True, "use_regex": True},
+        "model": {
+            "type": "BPE",
+            "dropout": None,
+            "unk_token": None,
+            "continuing_subword_prefix": None,
+            "end_of_word_suffix": None,
+            "fuse_unk": False,
+            "byte_fallback": False,
+            "vocab": vocab,
+            "merges": [m.split(" ", 1) for m in merges if m],
+        },
+    }
+
+
+def build_tokenizer_config(reader) -> dict:
+    """A minimal ``tokenizer_config.json`` (chat template + special tokens) for a GGUF model."""
+
+    def first(key):
+        for value in _as_list(reader.field(key)):
+            return value
+        return None
+
+    tokens = [str(t) for t in _as_list(reader.field("tokenizer.ggml.tokens"))]
+
+    def token_of(key) -> str | None:
+        index = first(key)
+        return tokens[int(index)] if index is not None and int(index) < len(tokens) else None
+
+    config = {
+        "tokenizer_class": "Qwen2Tokenizer",
+        "model_max_length": int(reader.field("tokenizer.ggml.model_max_length", 131072) or 131072),
+        "add_bos_token": bool(reader.field("tokenizer.ggml.add_bos_token", False)),
+        "add_eos_token": bool(reader.field("tokenizer.ggml.add_eos_token", False)),
+        "clean_up_tokenization_spaces": False,
+    }
+    for key, name in (("tokenizer.ggml.bos_token_id", "bos_token"),
+                      ("tokenizer.ggml.eos_token_id", "eos_token"),
+                      ("tokenizer.ggml.padding_token_id", "pad_token"),
+                      ("tokenizer.ggml.unknown_token_id", "unk_token")):
+        token = token_of(key)
+        if token is not None:
+            config[name] = token
+    template = reader.field("tokenizer.chat_template")
+    if template:
+        config["chat_template"] = str(template)
+    return config
+
+
+def ensure_sidecar(model_dir: str | Path) -> list[str]:
+    """Write ``tokenizer.json``/``tokenizer_config.json`` beside a GGUF when they are absent.
+
+    Returns the names of the files written (empty when nothing was missing). A directory
+    that already holds a ``tokenizer.json`` is left untouched.
+    """
+
+    directory = Path(model_dir)
+    if (directory / "tokenizer.json").is_file():
+        return []
+    reader = open_file(directory)
+    if reader is None:
+        return []
+    written: list[str] = []
+    with reader:
+        for filename, builder in (("tokenizer.json", build_tokenizer_json),
+                                  ("tokenizer_config.json", build_tokenizer_config)):
+            path = directory / filename
+            if path.is_file():
+                continue
+            tmp = path.with_suffix(path.suffix + ".tmp")
+            tmp.write_text(json.dumps(builder(reader), ensure_ascii=False), encoding="utf-8")
+            tmp.replace(path)
+            written.append(filename)
+    return written
+
+
+__all__ = ["build_tokenizer_config", "build_tokenizer_json", "ensure_sidecar"]
diff --git a/tests/test_gguf_tokenizer.py b/tests/test_gguf_tokenizer.py
