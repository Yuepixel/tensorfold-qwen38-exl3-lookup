+def load_gguf(gguf_path: str | Path, device: str = "cuda", *, tiled: bool = False, mlp=None) -> Weights:
+    """A GGUF checkpoint, its tensors dequantized to bf16 and read through the dense (``layout='dense'``) kernels."""
+
+    import numpy as np
+
+    from tensorfold.gguf import GgufReader
+    from tensorfold.gguf import hf
