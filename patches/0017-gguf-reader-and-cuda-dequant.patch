--- /dev/null
+++ b/src/tensorfold/gguf/hf.py
@@ -0,0 +1,202 @@
+"""Read a GGUF checkpoint as a dense bf16 model: an HF-style config, header index and tensor names.
+
+A GGUF file carries its hyperparameters and tensors under llama.cpp names; the CUDA
+loaders here expect a Hugging Face ``config.json`` and ``model.layers.*`` tensor names.
+This module bridges the two so a GGUF directory can be detected, admitted and loaded
+through the same code paths a safetensors checkpoint uses.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+from .reader import GgufReader
+
+# llama.cpp general.architecture -> TensorFold model_type
+ARCH_MODEL_TYPES = {
+    "qwen35": "qwen3_5",
+    "qwen35moe": "qwen3_5_moe",
+}
+
+# GGUF block tensor suffix -> HF module suffix (Qwen3.5 Gated-DeltaNet + attention, shared FFN)
+_BLOCK = {
+    "attn_norm.weight": "input_layernorm.weight",
+    "post_attention_norm.weight": "post_attention_layernorm.weight",
+    "ffn_gate.weight": "mlp.gate_proj.weight",
+    "ffn_up.weight": "mlp.up_proj.weight",
+    "ffn_down.weight": "mlp.down_proj.weight",
+    # Gated DeltaNet (linear attention) layers
+    "attn_qkv.weight": "linear_attn.in_proj_qkv.weight",
+    "attn_gate.weight": "linear_attn.in_proj_z.weight",
+    "ssm_alpha.weight": "linear_attn.in_proj_a.weight",
+    "ssm_beta.weight": "linear_attn.in_proj_b.weight",
+    "ssm_out.weight": "linear_attn.out_proj.weight",
+    "ssm_conv1d.weight": "linear_attn.conv1d.weight",
+    "ssm_a": "linear_attn.A_log",
+    "ssm_dt.bias": "linear_attn.dt_bias",
+    "ssm_norm.weight": "linear_attn.norm.weight",
+    # full-attention layers
+    "attn_q.weight": "self_attn.q_proj.weight",
+    "attn_k.weight": "self_attn.k_proj.weight",
+    "attn_v.weight": "self_attn.v_proj.weight",
+    "attn_output.weight": "self_attn.o_proj.weight",
+    "attn_q_norm.weight": "self_attn.q_norm.weight",
+    "attn_k_norm.weight": "self_attn.k_norm.weight",
+}
+
+_GLOBAL = {
+    "token_embd.weight": "model.embed_tokens.weight",
+    "output_norm.weight": "model.norm.weight",
+    "output.weight": "lm_head.weight",
+}
+
+_F32_NAMES = (".A_log", ".dt_bias")
+
+
+def find_file(model_dir: str | Path) -> Path | None:
+    """The GGUF file of a directory, or None when the directory holds none."""
+
+    files = sorted(Path(model_dir).glob("*.gguf"))
+    return files[0] if files else None
+
+
+def has_gguf(model_dir: str | Path) -> bool:
+    return find_file(model_dir) is not None
+
+
+def open_file(model_dir: str | Path) -> GgufReader | None:
+    path = find_file(model_dir)
+    return None if path is None else GgufReader(path)
+
+
+def model_type(reader: GgufReader) -> str:
+    arch = reader.architecture or ""
+    known = ARCH_MODEL_TYPES.get(arch)
+    if known is None:
+        raise NotImplementedError(
+            f"GGUF architecture {arch!r} is not supported yet (known: {', '.join(sorted(ARCH_MODEL_TYPES))})")
+    return known
+
+
+def hf_name(gguf_name: str) -> str | None:
+    """The Hugging Face tensor name a GGUF tensor maps to, or None when it has no dense equivalent."""
+
+    if gguf_name in _GLOBAL:
+        return _GLOBAL[gguf_name]
+    if gguf_name.startswith("blk."):
+        _, index, rest = gguf_name.split(".", 2)
+        suffix = _BLOCK.get(rest)
+        return None if suffix is None else f"model.layers.{index}.{suffix}"
+    return None
+
+
+def name_map(reader: GgufReader) -> dict[str, str]:
+    """GGUF tensor name -> HF tensor name, for every tensor this reader maps."""
+
+    out = {}
+    for name in reader.keys():
+        mapped = hf_name(name)
+        if mapped is not None:
+            out[name] = mapped
+    return out
+
+
+def tied_lm_head(reader: GgufReader) -> bool:
+    """Whether the checkpoint ties the output head to the token embedding (no separate output.weight)."""
+
+    return "output.weight" not in reader
+
+
+def _section(reader: GgufReader) -> tuple[int, int, int]:
+    values = reader.field("qwen35.rope.dimension_sections") or reader.field(
+        f"{reader.architecture}.rope.dimension_sections") or []
+    values = [int(v) for v in values][:3]
+    while len(values) < 3:
+        values.append(0)
+    return values[0], values[1], values[2]
+
+
+def to_hf_config(reader: GgufReader) -> dict:
+    """An HF-style config dict (with a ``text_config`` and a gguf quantization block) for a Qwen3.5 GGUF."""
+
+    arch = reader.architecture or ""
+    prefix = f"{arch}."
+
+    def get(key: str, default=None):
+        return reader.field(prefix + key, default)
+
+    mt = model_type(reader)
+    hidden = int(get("embedding_length"))
+    heads = int(get("attention.head_count"))
+    head_dim = int(get("attention.key_length") or hidden // heads)
+    interval = int(get("full_attention_interval", 4))
+    layers = int(get("block_count"))
+    eps = float(get("attention.layer_norm_rms_epsilon", 1e-6))
+    rope_dims = int(get("rope.dimension_count") or head_dim // 4)
+    rope = {
+        "rope_theta": float(get("rope.freq_base", 10000000.0)),
+        "partial_rotary_factor": rope_dims / head_dim,
+        "mrope_section": list(_section(reader)),
+    }
+    vocab = int(reader.info("token_embd.weight").shape[0]) if "token_embd.weight" in reader \
+        else len(reader.field("tokenizer.ggml.tokens") or [])
+    eos = reader.field("tokenizer.ggml.eos_token_id", 0)
+    eos = list(eos) if isinstance(eos, (list, tuple)) else [eos]
+    text = {
+        "model_type": mt,
+        "hidden_size": hidden,
+        "intermediate_size": int(get("feed_forward_length")),
+        "num_hidden_layers": layers,
+        "num_attention_heads": heads,
+        "num_key_value_heads": int(get("attention.head_count_kv", heads)),
+        "head_dim": head_dim,
+        "vocab_size": vocab,
+        "linear_num_key_heads": int(get("ssm.group_count")),
+        "linear_num_value_heads": int(get("ssm.group_count")),
+        "linear_key_head_dim": int(get("ssm.state_size")),
+        "linear_value_head_dim": int(get("ssm.state_size")),
+        "linear_conv_kernel_dim": int(get("ssm.conv_kernel", 4)),
+        "full_attention_interval": interval,
+        "rms_norm_eps": eps,
+        "rope_parameters": rope,
+        "rope_theta": rope["rope_theta"],
+        "partial_rotary_factor": rope["partial_rotary_factor"],
+        "max_position_embeddings": int(get("context_length", 0)),
+        "num_experts": int(get("expert_count", 0)),
+        "num_experts_per_tok": int(get("expert_used_count", 0)),
+        "moe_intermediate_size": int(get("expert_feed_forward_length", 0)),
+        "tie_word_embeddings": tied_lm_head(reader),
+        "layer_types": ["full_attention" if (i + 1) % interval == 0 else "linear_attention" for i in range(layers)],
+    }
+    return {
+        "model_type": mt,
+        "text_config": text,
+        "max_position_embeddings": text["max_position_embeddings"],
+        "eos_token_id": eos,
+        "tie_word_embeddings": text["tie_word_embeddings"],
+        "quantization_config": {"quant_method": "gguf"},
+    }
+
+
+def to_headers(reader: GgufReader) -> dict:
+    """A safetensors-shaped header index (HF names) of the dequantized (bf16, fp32 for A_log/dt_bias) tensors."""
+
+    dtype_of = lambda name: "F32" if name.endswith(_F32_NAMES) else "BF16"  # noqa: E731
+    item = {"F32": 4, "BF16": 2}
+    out = {}
+    for gguf_name, mapped in name_map(reader).items():
+        shape = list(reader.info(gguf_name).shape)
+        dtype = dtype_of(mapped)
+        n_bytes = 1
+        for dim in shape:
+            n_bytes *= dim
+        n_bytes *= item[dtype]
+        out[mapped] = {"dtype": dtype, "shape": shape, "data_offsets": [0, n_bytes]}
+    if tied_lm_head(reader):                      # the head is a view of the embedding
+        embed = out.get("model.embed_tokens.weight")
+        if embed is not None:
+            out["lm_head.weight"] = dict(embed)
+    return out
+
+
+__all__ = ["ARCH_MODEL_TYPES", "find_file", "has_gguf", "hf_name", "model_type", "name_map", "open_file",
+           "tied_lm_head", "to_hf_config", "to_headers"]
