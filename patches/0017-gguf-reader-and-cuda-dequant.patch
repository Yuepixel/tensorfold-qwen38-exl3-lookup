diff --git a/src/tensorfold/cuda/gguf_experts.py b/src/tensorfold/cuda/gguf_experts.py
new file mode 100644
index 0000000..5a1997d
--- /dev/null
+++ b/src/tensorfold/cuda/gguf_experts.py
@@ -0,0 +1,200 @@
+"""Grouped MoE experts read straight from GGUF blocks: the routed experts keep their raw
+q4_k/q5_k/q6_k blocks on the GPU and are dequantized inside a grouped matmul, while the
+(small, differently quantized) shared expert is dequantized once to dense bf16.
+
+This mirrors ``cuda/experts.py``'s interface — ``width``/``dims``/``count``/``swiglu`` and
+the ``run_gate_up``/``run_down`` methods — so ``cuda/moe.py`` runs either container unchanged.
+The plan (``route``/``Plan``) and the combine step are weight-format-agnostic and reused as is.
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+from .kernels.affine_kernels import GGML_BLOCK
+
+
+@triton.jit
+def _deq(W, base, colok, j, BLK: tl.constexpr, QT: tl.constexpr):
+    """Dequantize one block's values for 32 output rows: W holds the raw bytes, ``base`` is
+    the block's byte offset per output row (``cols[:, None] * RB`` plus the block offset),
+    and ``j`` is arange(BLK). Same block formats as ``affine_kernels.ggml``."""
+
+    if QT == 0:                                                    # Q8_0: d f16, then 32 int8
+        d = (tl.load(W + base).to(tl.uint16) | (tl.load(W + base + 1).to(tl.uint16) << 8)).to(
+            tl.float16, bitcast=True).to(tl.float32)
+        qb = tl.load(W + base + 2 + j[None, :], mask=colok[:, None], other=0).to(tl.int8, bitcast=True)
+        return d * qb.to(tl.float32)
+    elif QT == 1:                                                  # Q4_K: d, dmin f16, 12 scale bytes, 128 nibbles
+        d = (tl.load(W + base).to(tl.uint16) | (tl.load(W + base + 1).to(tl.uint16) << 8)).to(
+            tl.float16, bitcast=True).to(tl.float32)
+        dmin = (tl.load(W + base + 2).to(tl.uint16) | (tl.load(W + base + 3).to(tl.uint16) << 8)).to(
+            tl.float16, bitcast=True).to(tl.float32)
+        s8 = tl.arange(0, 8)
+        t = tl.where(s8 < 4, s8, s8 - 4)
+        bt = tl.load(W + base + 4 + t[None, :], mask=colok[:, None], other=0)
+        b4 = tl.load(W + base + 8 + t[None, :], mask=colok[:, None], other=0)
+        b8 = tl.load(W + base + 12 + t[None, :], mask=colok[:, None], other=0)
+        sc = tl.where(s8[None, :] < 4, bt & 0x3F, (b8 & 0x0F) | ((bt >> 2) & 0x30))
+        mm = tl.where(s8[None, :] < 4, b4 & 0x3F, (b8 >> 4) | ((b4 >> 2) & 0x30))
+        Sce = tl.reshape(tl.broadcast_to(sc[:, :, None], (32, 8, BLK // 8)), (32, BLK)).to(tl.float32)
+        Mme = tl.reshape(tl.broadcast_to(mm[:, :, None], (32, 8, BLK // 8)), (32, BLK)).to(tl.float32)
+        g, wb, sub = j // 64, j % 32, (j // 32) % 2
+        qb = tl.load(W + base + 16 + (g * 32 + wb)[None, :], mask=colok[:, None], other=0)
+        q = (qb >> (sub * 4)[None, :]) & 0xF
+        return d * Sce * q.to(tl.float32) - dmin * Mme
+    elif QT == 2:                                                  # Q5_K: Q4_K plus a 32-byte high-bit plane
+        d = (tl.load(W + base).to(tl.uint16) | (tl.load(W + base + 1).to(tl.uint16) << 8)).to(
+            tl.float16, bitcast=True).to(tl.float32)
+        dmin = (tl.load(W + base + 2).to(tl.uint16) | (tl.load(W + base + 3).to(tl.uint16) << 8)).to(
+            tl.float16, bitcast=True).to(tl.float32)
+        s8 = tl.arange(0, 8)
+        t = tl.where(s8 < 4, s8, s8 - 4)
+        bt = tl.load(W + base + 4 + t[None, :], mask=colok[:, None], other=0)
+        b4 = tl.load(W + base + 8 + t[None, :], mask=colok[:, None], other=0)
+        b8 = tl.load(W + base + 12 + t[None, :], mask=colok[:, None], other=0)
+        sc = tl.where(s8[None, :] < 4, bt & 0x3F, (b8 & 0x0F) | ((bt >> 2) & 0x30))
+        mm = tl.where(s8[None, :] < 4, b4 & 0x3F, (b8 >> 4) | ((b4 >> 2) & 0x30))
+        Sce = tl.reshape(tl.broadcast_to(sc[:, :, None], (32, 8, BLK // 8)), (32, BLK)).to(tl.float32)
+        Mme = tl.reshape(tl.broadcast_to(mm[:, :, None], (32, 8, BLK // 8)), (32, BLK)).to(tl.float32)
+        g, wb, sub = j // 64, j % 32, (j // 32) % 2
+        qb = tl.load(W + base + 48 + (g * 32 + wb)[None, :], mask=colok[:, None], other=0)
+        qh = tl.load(W + base + 16 + wb[None, :], mask=colok[:, None], other=0)
+        q = ((qb >> (sub * 4)[None, :]) & 0xF) | (((qh >> (j // 32)[None, :]) & 1) << 4)
+        return d * Sce * q.to(tl.float32) - dmin * Mme
+    else:                                                          # Q6_K: 16 sub-scales, 128 low nibbles, 64 2-bit planes
+        a, rem = j // 128, j % 128
+        bb, c, db, w2 = rem // 64, rem % 64, rem // 32, j % 32
+        ql = tl.load(W + base + (a * 64 + c)[None, :], mask=colok[:, None], other=0)
+        nib = (ql >> (bb * 4)[None, :]) & 0xF
+        qh = tl.load(W + base + 128 + (a * 32 + w2)[None, :], mask=colok[:, None], other=0)
+        hi = (qh >> (db * 2)[None, :]) & 3
+        q = ((nib | (hi << 4)).to(tl.int32) - 32).to(tl.float32)
+        sc = tl.load(W + base + 192 + (j // 16)[None, :], mask=colok[:, None], other=0)
+        d = (tl.load(W + base + 208).to(tl.uint16) | (tl.load(W + base + 209).to(tl.uint16) << 8)).to(
+            tl.float16, bitcast=True).to(tl.float32)
+        return d * sc.to(tl.int8, bitcast=True).to(tl.float32) * q
+
+
+@triton.jit
+def ggml_gate_up(X, GA, UP, OUT, ITEMS, COUNTS, MEMBERS, E_ROUTED,
+                 SLOTS: tl.constexpr, RB: tl.constexpr, N: tl.constexpr, K: tl.constexpr,
+                 BLK: tl.constexpr, QT: tl.constexpr, TILE: tl.constexpr):
+    """Program (item, 32 output columns): an item's member (token, expert) pairs run the
+    expert's gate and up projections from raw GGUF blocks, SwiGLU's them and write the
+    activation to OUT[pair, :]. Items of the shared expert (id E_ROUTED) are skipped."""
+
+    it = tl.program_id(0)
+    if it < tl.load(COUNTS):
+        e = tl.load(ITEMS + it * 3)
+        if e < E_ROUTED:
+            first = tl.load(ITEMS + it * 3 + 1)
+            cnt = tl.load(ITEMS + it * 3 + 2)
+            cols = tl.program_id(1) * 32 + tl.arange(0, 32)
+            colok = cols < N
+            j = tl.arange(0, BLK)
+            step = RB // (K // BLK)                               # bytes per block
+            ebase = e * N * RB
+            gbase = ebase + cols[:, None] * RB
+            ubase = ebase + cols[:, None] * RB
+            for t in tl.static_range(TILE // 16):
+                mi = t * 16 + tl.arange(0, 16)
+                ok = mi < cnt
+                p = tl.load(MEMBERS + first + mi, mask=ok, other=0)
+                r = p // SLOTS
+                accg = tl.zeros((16, 32), tl.float32)
+                accu = tl.zeros((16, 32), tl.float32)
+                for b in range(0, K // BLK):
+                    xk = b * BLK + j
+                    x = tl.load(X + r[:, None] * K + xk[None, :], mask=ok[:, None], other=0)
+                    wg = _deq(GA, gbase + b * step, colok, j, BLK, QT)
+                    wu = _deq(UP, ubase + b * step, colok, j, BLK, QT)
+                    accg += tl.dot(x, tl.trans(wg.to(tl.bfloat16)), input_precision="ieee")
+                    accu += tl.dot(x, tl.trans(wu.to(tl.bfloat16)), input_precision="ieee")
+                act = (accg / (1.0 + tl.exp(-accg))) * accu
+                tl.store(OUT + p[:, None] * N + cols[None, :], act.to(tl.bfloat16), mask=ok[:, None] & colok[None, :])
+
+
+@triton.jit
+def ggml_down(ACT, W, OUT, ITEMS, COUNTS, MEMBERS, E_ROUTED,
+              SLOTS: tl.constexpr, RB: tl.constexpr, N: tl.constexpr, K: tl.constexpr,
+              BLK: tl.constexpr, QT: tl.constexpr, TILE: tl.constexpr, OUT_F32: tl.constexpr):
+    """Program (item, 32 output columns): an item's member pairs run the expert's down
+    projection from raw GGUF blocks into OUT[pair, :]; shared-expert items are skipped."""
+
+    it = tl.program_id(0)
+    if it < tl.load(COUNTS):
+        e = tl.load(ITEMS + it * 3)
+        if e < E_ROUTED:
+            first = tl.load(ITEMS + it * 3 + 1)
+            cnt = tl.load(ITEMS + it * 3 + 2)
+            cols = tl.program_id(1) * 32 + tl.arange(0, 32)
+            colok = cols < N
+            j = tl.arange(0, BLK)
+            step = RB // (K // BLK)
+            base = e * N * RB + cols[:, None] * RB
+            for t in tl.static_range(TILE // 16):
+                mi = t * 16 + tl.arange(0, 16)
+                ok = mi < cnt
+                p = tl.load(MEMBERS + first + mi, mask=ok, other=0)
+                acc = tl.zeros((16, 32), tl.float32)
+                for b in range(0, K // BLK):
+                    kk = b * BLK + j
+                    x = tl.load(ACT + p[:, None] * K + kk[None, :], mask=ok[:, None], other=0)
+                    wv = _deq(W, base + b * step, colok, j, BLK, QT)
+                    acc += tl.dot(x, tl.trans(wv.to(tl.bfloat16)), input_precision="ieee")
+                out = acc if OUT_F32 else acc.to(tl.bfloat16)
+                tl.store(OUT + p[:, None] * N + cols[None, :], out, mask=ok[:, None] & colok[None, :])
+
+
+class GgufExperts:
+    """One qwen35moe layer's routed experts (raw GGUF blocks) plus the dense shared expert.
+
+    ``gate``/``up`` are [E, I, RB] uint8 (q4_k); ``down_w`` is [E, D, RB] uint8 (q5_k or
+    q6_k, per layer), RB being ``(K / block) * bytes``. The shared expert's three
+    projections are dequantized once to dense bf16 (tiny next to the routed blocks).
+    """
+
+    swiglu = True
+
+    def __init__(self, gate: torch.Tensor, up: torch.Tensor, down_w: torch.Tensor,
+                 gate_quant: str, down_quant: str, sh_gate: torch.Tensor, sh_up: torch.Tensor,
+                 sh_down: torch.Tensor) -> None:
+        self.count, width, _ = gate.shape
+        _, dims, _ = down_w.shape
+        self.width, self.dims = int(width), int(dims)
+        self.gate, self.up, self.down_w = gate.contiguous(), up.contiguous(), down_w.contiguous()
+        self.up_qt, self.up_blk, _ = GGML_BLOCK[gate_quant]
+        self.down_qt, self.down_blk, _ = GGML_BLOCK[down_quant]
+        self.up_rb, self.down_rb = self.gate.shape[2], self.down_w.shape[2]
+        self.sh_gate = sh_gate.contiguous().to(torch.bfloat16)
+        self.sh_up = sh_up.contiguous().to(torch.bfloat16)
+        self.sh_down = sh_down.contiguous().to(torch.bfloat16)
+
+    def run_gate_up(self, x: torch.Tensor, plan, out: torch.Tensor, rows: int) -> None:
+        """x [R, D] bf16 -> out [R * slots, I] bf16: each routed pair's SwiGLU activation from
+        raw blocks, then the shared expert's activation into the last slot."""
+
+        grid = (plan.items.shape[0], triton.cdiv(self.width, 32))
+        ggml_gate_up[grid](x, self.gate, self.up, out, plan.items, plan.counts, plan.members, self.count,
+                           SLOTS=plan.slots, RB=self.up_rb, N=self.width, K=self.dims, BLK=self.up_blk,
+                           QT=self.up_qt, TILE=plan.tile, num_warps=4, enable_fp_fusion=False)
+        shared = out.view(-1, plan.slots, self.width)[:rows, plan.slots - 1, :]
+        gate = x[:rows] @ self.sh_gate.t()
+        up = x[:rows] @ self.sh_up.t()
+        shared.copy_((gate * torch.sigmoid(gate) * up).to(shared.dtype))
+
+    def run_down(self, act: torch.Tensor, plan, out: torch.Tensor, rows: int) -> None:
+        """act [R * slots, I] bf16 -> out [R * slots, D] (fp32 decode, bf16 prefill): each
+        routed pair's down projection from raw blocks, then the shared expert into the last slot."""
+
+        grid = (plan.items.shape[0], triton.cdiv(self.dims, 32))
+        ggml_down[grid](act, self.down_w, out, plan.items, plan.counts, plan.members, self.count,
+                        SLOTS=plan.slots, RB=self.down_rb, N=self.dims, K=self.width, BLK=self.down_blk,
+                        QT=self.down_qt, TILE=plan.tile, OUT_F32=(out.dtype == torch.float32),
+                        num_warps=4, enable_fp_fusion=False)
+        shared = out.view(-1, plan.slots, self.dims)[:rows, plan.slots - 1, :]
+        a = act.view(-1, plan.slots, self.width)[:rows, plan.slots - 1, :]
+        shared.copy_((a @ self.sh_down.t()).to(shared.dtype))
