+    qtype = {"q4_k": GGMLQuantizationType.Q4_K, "q5_k": GGMLQuantizationType.Q5_K, "q6_k": GGMLQuantizationType.Q6_K}[kind]
+    assert GGML_QUANT_SIZES[qtype] == (QK_K, _SIZES[kind])
+
+
+@pytest.mark.parametrize("kind", ["q4_k", "q5_k", "q6_k"])
+def test_bit_exact_vs_reference(kind: str) -> None:
+    rng = np.random.default_rng(1234)
+    n_blocks = 5
+    raw = rng.integers(0, 256, size=(n_blocks, _SIZES[kind]), dtype=np.uint8)
+    raw[:, 0:4] = 0
+    raw[:, 0:2] = np.array([0x00, 0x38], dtype=np.uint8)
+
+    reference = _REFERENCE[kind].dequantize_blocks(raw).astype(np.float32).reshape(-1)
+    ours = _FUNCS[kind](raw.reshape(-1), (n_blocks * QK_K,))
+    np.testing.assert_array_equal(ours, reference)
+
+
+@pytest.mark.parametrize("kind", ["q4_k", "q5_k", "q6_k"])
+def test_shape_round_trip(kind: str) -> None:
+    rng = np.random.default_rng(7)
+    raw = rng.integers(0, 256, size=(2, 3, _SIZES[kind]), dtype=np.uint8)
+    raw[..., 0:4] = 0
+    out = _FUNCS[kind](raw.reshape(-1), (2, 3 * QK_K))
+    assert out.shape == (2, 3 * QK_K)
+    assert out.dtype == np.float32
+
+
+@pytest.mark.parametrize("kind", ["q4_k", "q5_k", "q6_k"])
+def test_wrong_byte_count(kind: str) -> None:
+    with pytest.raises(ValueError):
+        _FUNCS[kind](np.zeros(_SIZES[kind] + 1, dtype=np.uint8), (QK_K,))
+
+
+def test_misaligned_element_count() -> None:
+    with pytest.raises(ValueError):
+        dequantize_q4_k(np.zeros(64, dtype=np.uint8), (128,))
