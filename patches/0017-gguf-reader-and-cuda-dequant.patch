new file mode 100644
index 0000000..62e1cc9
--- /dev/null
+++ b/tests/test_gguf_moe_experts.py
@@ -0,0 +1,86 @@
+"""The grouped GGUF MoE kernels must reproduce per-expert CPU dequant + SwiGLU/down in bf16."""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("triton")
+
+from tensorfold.gguf.dequant import DEQUANTIZERS
+from tensorfold.cuda.gguf_experts import GgufExperts
+
+BLOCKS = {"q4_k": (256, 144), "q5_k": (256, 176)}
+
+
+def _raw(qtype: str, n: int, k: int, seed: int) -> np.ndarray:
+    blk, byt = BLOCKS[qtype]
+    rng = np.random.default_rng(seed)
+    nb = k // blk
+    raw = rng.integers(0, 256, size=(n, nb * byt), dtype=np.uint8)
+    for row in range(n):
+        for b in range(nb):
+            base = b * byt
+            raw[row, base:base + 2] = np.frombuffer(np.float16(0.02).tobytes(), np.uint8)
+            raw[row, base + 2:base + 4] = np.frombuffer(np.float16(0.01).tobytes(), np.uint8)
+    return raw
+
+
+class _Plan:
+    """The subset of ``cuda.experts.Plan`` the kernels read: one routed item (expert 0, all rows)
+    and one shared item (id E), every row at slot 0 routed and slot 1 shared."""
+
+    def __init__(self, rows: int, slots: int, experts: int) -> None:
+        self.slots, self.tile = slots, 16
+        self.items = torch.tensor([[0, 0, rows], [experts, rows, rows]], dtype=torch.int32, device="cuda")
+        self.counts = torch.tensor([2, 1], dtype=torch.int32, device="cuda")
+        members = []
+        for slot in range(slots):
+            members += [r * slots + slot for r in range(rows)]
+        self.members = torch.tensor(members, dtype=torch.int32, device="cuda")
+
+
+@pytest.mark.parametrize("quant", list(BLOCKS))
+def test_grouped_gate_up_and_down_match_reference(quant):
+    if not torch.cuda.is_available():
+        pytest.skip("needs CUDA")
+    E, I, D, R, slots = 2, 256, 256, 3, 2
+
+    gate = torch.from_numpy(np.stack([_raw(quant, I, D, 1 + e) for e in range(E)])).cuda()
+    up = torch.from_numpy(np.stack([_raw(quant, I, D, 10 + e) for e in range(E)])).cuda()
+    down = torch.from_numpy(np.stack([_raw(quant, D, I, 20 + e) for e in range(E)])).cuda()
+    sh_gate = torch.randn(I, D, device="cuda", dtype=torch.bfloat16)
+    sh_up = torch.randn(I, D, device="cuda", dtype=torch.bfloat16)
+    sh_down = torch.randn(D, I, device="cuda", dtype=torch.bfloat16)
+
+    ex = GgufExperts(gate, up, down, quant, quant, sh_gate, sh_up, sh_down)
+    assert (ex.count, ex.width, ex.dims, ex.swiglu) == (E, I, D, True)
+
+    plan = _Plan(R, slots, E)
+    x = torch.randn(R, D, device="cuda", dtype=torch.bfloat16)
+
+    act = torch.empty(R * slots, I, device="cuda", dtype=torch.bfloat16)
+    ex.run_gate_up(x, plan, act, R)
+
+    g0 = torch.from_numpy(DEQUANTIZERS[quant](_raw(quant, I, D, 1), (I, D))).cuda().float()
+    u0 = torch.from_numpy(DEQUANTIZERS[quant](_raw(quant, I, D, 10), (I, D))).cuda().float()
+    xf = x.float()
+    ref_routed = (xf @ g0.T) * torch.sigmoid(xf @ g0.T) * (xf @ u0.T)
+    ref_shared = (xf @ sh_gate.float().T) * torch.sigmoid(xf @ sh_gate.float().T) * (xf @ sh_up.float().T)
+    a = act.float().view(R, slots, I)
+    tol = 0.05 * ref_routed.abs().max().item() + 0.1
+    assert (a[:, 0, :] - ref_routed).abs().max().item() < tol
+    tol_sh = 0.03 * ref_shared.abs().max().item() + 0.1
+    assert (a[:, 1, :] - ref_shared).abs().max().item() < tol_sh
+
+    out = torch.empty(R * slots, D, device="cuda", dtype=torch.float32)
+    ex.run_down(act, plan, out, R)
+
+    d0 = torch.from_numpy(DEQUANTIZERS[quant](_raw(quant, D, I, 20), (D, I))).cuda().float()
+    y = out.view(R, slots, D)
+    ref_y = (act.float() @ d0.T).view(R, slots, D)
+    ref_ys = act.float().view(R, slots, I)[:, 1, :] @ sh_down.float().T
+    tol_d = 0.05 * ref_y.abs().max().item() + 0.1
+    assert (y[:, 0, :] - ref_y[:, 0, :]).abs().max().item() < tol_d
+    tol_ds = 0.03 * ref_ys.abs().max().item() + 0.1
+    assert (y[:, 1, :] - ref_ys).abs().max().item() < tol_ds
