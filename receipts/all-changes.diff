+#!/usr/bin/env bash
+set -e
+# P7 prompt-lookup draft arm (qwen4_exp). Default on with the P7.4-calibrated forced policy l7:2
+# (up to 7 drafts, matches of >=2 tokens): +14~37% on edit/agent decode, +2% chat, roughly neutral
+# elsewhere, byte-exact vs serial either way. Set TF_EXL3_LOOKUP="" to revert to MTP-only (A6), or to
+# another lN[:M] / "auto" (auto is experimental; its gate cost model is not yet calibrated).
+export TF_EXL3_LOOKUP="${TF_EXL3_LOOKUP-l7:2}"
+exec /usr/local/bin/tensorfold serve /models/Qwen3.8-Flash-Next-exl3-3.05bpw_h5_ng5 --host 0.0.0.0 --port 8080 > /tmp/serve.log 2>&1
