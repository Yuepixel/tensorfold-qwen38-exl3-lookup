@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# P7 A1 byte-exact probe: same 3 prompt classes, serial (draft:false) vs drafted (draft:true).
+# Prints "<label> draft=<flag> <token_sha>". Run once against the lookup server; the
+# draft:false shas are the byte-exact reference and must match the drafted ones.
+set -u
+U=http://127.0.0.1:8080/v1/chat/completions
+H='Content-Type: application/json'
+M=Qwen3.8-Flash-Next-exl3-3.05bpw_h5_ng5
+run() {
+  local label="$1" content="$2" draft="$3"
+  local body="{\"model\":\"$M\",\"messages\":[{\"role\":\"user\",\"content\":$content}],\"temperature\":0,\"max_tokens\":96,\"draft\":$draft}"
+  local out sha
+  out=$(curl -s --max-time 240 "$U" -H "$H" -d "$body")
+  sha=$(printf '%s' "$out" | grep -o '"token_sha": *"[0-9a-f]*"' | head -1)
+  echo "$label draft=$draft ${sha:-NO_SHA}"
+}
+# prose / chat
+run prose '"法国首都是哪座城市？只答城市名。"' false
+run prose '"法国首都是哪座城市？只答城市名。"' true
+# code
+run code '"用 Python 写一个函数 fib(n) 返回前 n 个斐波那契数，只输出代码。"' false
+run code '"用 Python 写一个函数 fib(n) 返回前 n 个斐波那契数，只输出代码。"' true
+# edit / repetition (drives the lookup arm)
+run repeat '"严格按模式续写，每行只写一个词：\n1. apple\n2. apple\n3. apple\n4. apple\n5."' false
+run repeat '"严格按模式续写，每行只写一个词：\n1. apple\n2. apple\n3. apple\n4. apple\n5."' true
