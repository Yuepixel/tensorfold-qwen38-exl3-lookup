+#!/usr/bin/env bash
+# P7 server restart helper: kill the running serve, start it with the given lookup env, wait ready.
+# $1 = TF_EXL3_LOOKUP ("default" = omit env, let run_serve.sh's shipped default apply; "" = MTP-only),
+# $2 = TF_EXL3_LOOKUP_MIN (default 4)
+set -u
+SPEC="${1-l7:2}"
+MIN="${2:-4}"
+docker exec tf-exl3 pkill -f 'tensorfold serve' >/dev/null 2>&1
+sleep 3
+if [ "$SPEC" = "default" ]; then
+  docker exec -d tf-exl3 bash /src/TensorFold/run_serve.sh
+else
+  docker exec -e TF_EXL3_LOOKUP="$SPEC" -e TF_EXL3_LOOKUP_MIN="$MIN" -d tf-exl3 bash /src/TensorFold/run_serve.sh
+fi
+for i in $(seq 1 150); do
+  if curl -s --max-time 4 http://127.0.0.1:8080/v1/models >/dev/null 2>&1; then
+    echo READY
+    exit 0
+  fi
+  sleep 4
+done
+echo TIMEOUT
+exit 1
